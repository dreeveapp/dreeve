{
  "id": "[APP_HOST]",
  "name": "[APP_NAME]",
  "short_name": "[APP_SHORT_NAME]",
  "description": "[APP_SHORT_NAME] is a self-hosted, open-source dashboard for your sports and fitness data.",
  "categories": [
    "sports",
    "health",
    "fitness",
    "utilities"
  ],
  "start_url": "[APP_START_URL]",
  "scope": "[APP_HOST]",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "theme_color": "#F26822",
  "background_color": "#f9fafb",
  "icons": [
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/icon-192.maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/icon-512.maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/icon-512.png",
      "sizes": "any",
      "type": "image/png"
    },
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/icon-512.maskable.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/screenshots/dashboard.jpeg",
      "sizes": "750x1600",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Dashboard"
    },
    {
      "src": "[APP_BASE_PATH]/assets/images/manifest/screenshots/heatmap.jpeg",
      "sizes": "750x1600",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Heatmap"
    }
  ]
}