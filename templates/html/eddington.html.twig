<div class="flex items-center justify-between mb-4">
    <div class="flex min-w-0 items-center gap-x-1">
        {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
            'url': 'eddington',
            'label': 'Eddington'|trans
        }], 'disableMargin': true} %}
        <button data-popover-target="popover-eddington-info" type="button" class="hidden sm:inline-flex">
            <svg class="size-4 ml-1 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
            <span class="sr-only">{{ "Show information"|trans }}</span>
        </button>
        <div data-popover id="popover-eddington-info" role="tooltip" class="w-50 lg:w-md inline-block text-sm">
            <p class="p-3">{{ "The Eddington number in the context of cycling or running is defined as the maximum number E such that the athlete has covered at least E km on at least E days."|trans }}</p>
            <p class="p-3">{{ "For example, an Eddington number of 70 would imply that a cyclist has cycled at least 70 km or miles in a day on at least 70 occasions. Achieving a high Eddington number is difficult, since moving from, say, 70 to 75 will (probably) require more than five new long-distance workouts, since any workout shorter than 75 km or miles will no longer be included in the reckoning."|trans }}</p>
        </div>
    </div>
    <div class="flex items-center gap-x-2">
        <ul class="tabs tabs--pills" id="eddingtonUnitSystemTab" data-tabs="#eddingtonUnitSystemTabContent" role="tablist">
            {% for unitSystem in activeUnitSystem.casesWithPreferredFirst() %}
                <li role="presentation">
                    <a href="#" data-tabs-target="#eddingtonUnitSystem{{ unitSystem.value }}Tab" role="tab" aria-controls="eddingtonUnitSystem{{ unitSystem.value }}Tab">
                        {{ svg(unitSystem.getSvgIcon(), 'size-4', '') }}
                        <span class="hidden md:block">{{ unitSystem|trans }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
        {% include 'html/navigation/admin-edit-link.html.twig' with {
            path: 'admin/settings/metrics',
            redirectTo: 'eddington',
            title: "Metrics settings"|trans,
            label: "Settings"|trans({}, 'admin'),
            icon: 'cog'
        } %}
    </div>
</div>
{% autoescape false %}
     <div class="grid grid-cols-1 gap-4">
         <div id="eddingtonUnitSystemTabContent">
             {% for unitSystem in activeUnitSystem.casesWithPreferredFirst() %}
                 {% set eddingtonsForUnitSystem = eddingtons|filter(e => e.getUnitSystem() == unitSystem) %}
                 <div id="eddingtonUnitSystem{{ unitSystem.value }}Tab" role="tabpanel" aria-labelledby="eddingtonUnitSystem{{ unitSystem.value }}Tab">
                     {% if eddingtonsForUnitSystem|length > 1 %}
                         <ul class="tabs tabs--menu-item" id="eddington{{ unitSystem.value }}Tab" data-tabs="#eddington{{ unitSystem.value }}TabContent" role="tablist">
                             {% for eddington in eddingtonsForUnitSystem %}
                                 <li role="presentation">
                                     <a href="#" data-tabs-target="#{{ eddington.getId() }}" role="tab" aria-controls="{{ eddington.getId() }}">
                                         {{ eddington.getLabel() }} ({{ eddington.getNumber() }})
                                     </a>
                                 </li>
                             {% endfor %}
                         </ul>
                     {% endif %}
                     <div id="eddington{{ unitSystem.value }}TabContent">
                         {% for eddington in eddingtonsForUnitSystem %}
                             <div class="grid grid-cols-1 gap-4" id="{{ eddington.getId() }}" role="tabpanel" aria-labelledby="{{ eddington.getId() }}-tab">
                                 <div class="grid grid-cols-1 sm:grid-cols-3 gap-y-4 p-4 bg-white border border-gray-200 rounded-lg shadow-xs divide-y divide-gray-100 sm:divide-y-0 sm:divide-x">
                                     <div class="flex flex-col items-center justify-center text-center px-4 pb-4 sm:pb-0">
                                         <div class="text-xxs uppercase tracking-wider text-gray-500">{{ "Eddington number"|trans }}</div>
                                         <div class="text-5xl font-extrabold text-primary leading-tight">
                                             {{ eddington.getNumber() }}
                                         </div>
                                         <div class="text-xs text-gray-500">
                                             {{ eddington.getUnitSystem().distanceSymbol() }}
                                         </div>
                                     </div>
                                     {% set nextNumber = eddington.getNumber() + 1 %}
                                     {% set daysToNext = eddington.getDaysToCompleteForFutureNumbers()[nextNumber] ?? null %}
                                     <div class="flex flex-col items-center justify-center text-center px-4 pb-4 sm:pb-0">
                                         <div class="text-xxs uppercase tracking-wider text-gray-500">{{ "Next milestone"|trans }}</div>
                                         {% if daysToNext is not null %}
                                             <div class="text-5xl font-extrabold leading-tight">{{ daysToNext }}</div>
                                             <div class="text-xs text-gray-500">
                                                 {{ "days to reach {n}"|trans({'{n}': nextNumber}) }}
                                             </div>
                                         {% endif %}
                                     </div>
                                     <div class="flex flex-col items-center justify-center text-center px-4 pb-4 sm:pb-0">
                                         <div class="text-xxs uppercase tracking-wider text-gray-500">{{ "Longest day"|trans }}</div>
                                         <div class="text-5xl font-extrabold leading-tight">{{ eddington.getLongestDistanceInADay() }}</div>
                                         <div class="text-xs text-gray-500">{{ eddington.getUnitSystem().distanceSymbol() }}</div>
                                     </div>
                                 </div>
                                 <!-- CHARTS -->
                                 <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
                                     <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
                                         <h3 class="font-bold mb-4">{{ "Distance distribution"|trans }}</h3>
                                         <div class="h-64" data-echarts-options='{{ eddingtonCharts[eddington.getId()] }}'></div>
                                     </div>
                                     <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
                                         <h3 class="font-bold mb-4">{{ "Eddington over time"|trans }}</h3>
                                         <div class="h-64" data-echarts-options='{{ eddingtonHistoryCharts[eddington.getId()] }}'></div>
                                     </div>
                                 </div>
                                 <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
                                     <h3 class="font-bold mb-4">{{ "Upcoming numbers"|trans }}</h3>
                                     <div class="relative overflow-x-auto">
                                         <table class="data-table">
                                             <thead>
                                             <tr>
                                                 <th scope="col">{{ "Target"|trans }}</th>
                                                 <th scope="col">{{ "Days completed"|trans }}</th>
                                                 <th scope="col">{{ "Days to go"|trans }}</th>
                                                 <th scope="col" class="w-1/2">{{ "Progress"|trans }}</th>
                                             </tr>
                                             </thead>
                                             <tbody>
                                             {% for upcomingNumber in eddington.getUpcomingNumbers() %}
                                                 {% set timesCompleted = eddington.getTimesCompletedFor(upcomingNumber) %}
                                                 <tr>
                                                     <td class="font-medium text-gray-900 whitespace-nowrap">
                                                         {{ upcomingNumber }}<span class="text-xxs ml-px">{{ eddington.getUnitSystem().distanceSymbol() }}</span>
                                                     </td>
                                                     <td>{{ timesCompleted }}</td>
                                                     <td>{{ upcomingNumber - timesCompleted }}</td>
                                                     <td>
                                                         {% set relativeProgress = (timesCompleted / upcomingNumber * 100)|round %}
                                                         <div class="w-full rounded-full bg-gray-200">
                                                             {% if relativeProgress > 0 %}
                                                                 <div class="rounded-full bg-primary p-0.5 text-center text-xs leading-none font-medium text-white no-dark" style="width: {{ max(10, relativeProgress) }}%">
                                                                     {{ relativeProgress }}%
                                                                 </div>
                                                             {% else %}
                                                                 <div class="rounded-full p-0.5 text-center text-xs leading-none font-medium" style="width: 10%">
                                                                     0%
                                                                 </div>
                                                             {% endif %}
                                                         </div>
                                                     </td>
                                                 </tr>
                                             {% endfor %}
                                             </tbody>
                                         </table>
                                     </div>
                                 </div>
                             </div>
                         {% endfor %}
                     </div>
                 </div>
             {% endfor %}
         </div>
     </div>
 {% endautoescape %}