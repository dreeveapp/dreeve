<div class="flex items-center justify-between mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [
        {
            'url': 'gear',
            'label': 'Gear'|trans
        },
        {
            'url': 'gear/maintenance',
            'label': 'Maintenance'|trans
        }],
        'disableMargin': true} %}
    <div class="flex items-center gap-x-2">
        {% if isFeatureEnabled %}
            {% include 'html/navigation/admin-edit-link.html.twig' with {
                path: 'admin/gear/maintenance-logs/register',
                redirectTo: 'gear/maintenance',
                title: "Register maintenance"|trans,
                label: "Log maintenance"|trans({}, 'admin')
            } %}
        {% endif %}
        {% include 'html/navigation/admin-edit-link.html.twig' with {
            path: 'admin/gear/maintenance-config',
            redirectTo: 'gear/maintenance',
            title: "Configure gear maintenance"|trans,
            label: "Configure"|trans({}, 'admin'),
            icon: 'cog'
        } %}
    </div>
</div>
{% block content %}
    {% autoescape false %}
        <!-- GEAR SUB MENU -->
        {% include 'html/gear/gear-sub-menu.html.twig' with {activeMenuItem: 'gearMaintenance'} %}
        <div class="grid grid-cols-1 gap-4">
            <div class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
                <h3 class="mb-4 text-lg font-semibold">
                    {{ "Gear maintenance"|trans }}
                </h3>
                <div class="relative overflow-x-auto">
                    <table class="w-full text-sm text-center text-gray-500">
                        <thead class="text-gray-500 text-xxs uppercase font-semibold bg-gray-50">
                        <tr>
                            <th class="px-2"></th>
                            <th scope="col" class="px-2 py-3">
                                {{ "Gear"|trans }}
                            </th>
                            <th scope="col" class="text-left px-2 py-3">
                                {{ "Name"|trans }}
                            </th>
                            <th scope="col" class="px-6 py-3">
                                {{ "Dist."|trans }}
                            </th>
                            <th scope="col" class="px-6 py-3 max-w-120">
                                {{ "Components"|trans }}
                            </th>
                        </tr>
                        </thead>
                        <tbody id="table-gears" data-accordion="table-gears"
                               data-active-classes="text-gray-500"
                               data-inactive-classes="text-gray-500">
                        {% for gearWithComponents in gearsWithComponents %}
                            {% set gear = gearWithComponents.gear %}
                            {% set componentsAttachedToGear = gearWithComponents.components %}
                            <tr class="border-b aria-expanded:bg-gray-50 hover:aria-expanded:bg-gray-100 hover:bg-gray-50 cursor-pointer"
                                id="table-gears-header-{{ loop.index0 }}"
                                data-accordion-target="#table-gears-content-{{ loop.index0 }}"
                                aria-expanded="false" aria-controls="table-gears-content-{{ loop.index0 }}">
                                <td class="w-4 p-2 text-gray-900">
                                    <svg data-accordion-icon class="size-3 rotate-180 shrink-0" aria-hidden="true"
                                         xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M9 5 5 1 1 5"/>
                                    </svg>
                                </td>
                                <td class="py-2">
                                    <img class="w-auto h-8 rounded-sm object-cover lazy"
                                         src="{{ placeholderImage() }}"
                                         data-src="{{ gear.getLocalImagePath() }}"
                                         alt="{{ gear.getName() }}"/>
                                </td>
                                <th scope="row" class="text-left truncate px-2 py-2 font-medium text-gray-900 whitespace-nowrap">
                                    <div class="flex items-center">
                                        {% if gearIdsThatHaveDueTasks.has(gear.getId()) %}
                                            <span class="flex size-2 me-2 bg-red-500 rounded-full animate-pulse" title="{{ "One of your gear maintenance tasks is due"|trans }}"></span>
                                        {% endif %}
                                        <div>{{ gear.getName() }}</div>
                                    </div>
                                </th>
                                <td class="px-6 py-2 truncate">
                                    {{ gear.getDistance()|renderMeasurement(0) }}
                                </td>
                                <td class="px-6 py-2 truncate max-w-120">
                                    {{ componentsAttachedToGear|map(component => component.getLabel())|join(', ') }}
                                </td>
                            </tr>
                            <tr class="border-b hidden overflow-x-auto w-full"
                                id="table-gears-content-{{ loop.index0 }}"
                                aria-labelledby="table-gears-header-{{ loop.index0 }}">
                                <td colspan="5" class="p-4 text-left">
                                    <div class="grid gap-2">
                                        {% for gearComponent in componentsAttachedToGear %}
                                            {% include 'html/gear/maintenance/_gear-component.html.twig' with {gearComponent: gearComponent, maintenanceTaskStatuses: maintenanceTaskStatuses} only %}
                                        {% endfor %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% if componentsNotFitted|length > 0 %}
                <div class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
                    <h3 class="text-lg font-semibold">
                        {{ "Not fitted"|trans }}
                    </h3>
                    <p class="mb-4 text-sm text-gray-500">
                        {{ "These components are not installed on any gear at the moment."|trans }}
                    </p>
                    <div class="grid gap-2">
                        {% for gearComponent in componentsNotFitted %}
                            {% include 'html/gear/maintenance/_gear-component.html.twig' with {gearComponent: gearComponent, maintenanceTaskStatuses: maintenanceTaskStatuses} only %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% endautoescape %}
{% endblock %}