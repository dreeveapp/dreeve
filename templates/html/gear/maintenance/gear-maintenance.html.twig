<div class="flex items-center justify-between mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [
        {
            'url': 'gear',
            'label': 'Gear'|trans
        },
        {
            'url': 'gear/maintenance',
            'label': 'Maintenance'|trans
        }],
        'disableMargin': true} %}
    <div class="flex items-center gap-x-2">
        {% if isFeatureEnabled %}
            {% include 'html/navigation/admin-edit-link.html.twig' with {
                path: 'admin/gear/maintenance-logs/register',
                redirectTo: 'gear/maintenance',
                title: "Register maintenance"|trans,
                label: "Log maintenance"|trans({}, 'admin')
            } %}
        {% endif %}
        {% include 'html/navigation/admin-edit-link.html.twig' with {
            path: 'admin/gear/maintenance-config',
            redirectTo: 'gear/maintenance',
            title: "Configure gear maintenance"|trans,
            label: "Configure"|trans({}, 'admin'),
            icon: 'cog'
        } %}
    </div>
</div>
{% block content %}
    {% autoescape false %}
        <!-- GEAR SUB MENU -->
        {% include 'html/gear/gear-sub-menu.html.twig' with {activeMenuItem: 'gearMaintenance'} %}
        <div class="mb-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <h3 class="p-4 text-lg font-semibold">
                {{ "Gear maintenance"|trans }}
            </h3>
            <div class="grid items-center gap-x-4 grid-cols-[3rem_minmax(0,1fr)_5rem_0.75rem] lg:grid-cols-[3rem_minmax(0,1fr)_6rem_minmax(0,2fr)_0.75rem] px-4 py-3 border-t border-gray-200 bg-gray-50 text-gray-500 text-xxs uppercase font-semibold">
                <div>{{ "Gear"|trans }}</div>
                <div>{{ "Name"|trans }}</div>
                <div>{{ "Dist."|trans }}</div>
                <div class="hidden lg:block">{{ "Components"|trans }}</div>
                <div></div>
            </div>
            {% for gear in gearsAttachedToComponents %}
                {% set componentsAttachedToGear = gearComponents|filter(component => component.isAttachedTo(gear.getId())) %}
                <details class="group/row border-t border-gray-100">
                    <summary class="grid items-center gap-x-4 grid-cols-[3rem_minmax(0,1fr)_5rem_0.75rem] lg:grid-cols-[3rem_minmax(0,1fr)_6rem_minmax(0,2fr)_0.75rem] list-none cursor-pointer px-4 py-2.5 hover:bg-gray-50 select-none">
                        <div>
                            <img class="w-auto h-8 rounded-sm object-cover lazy"
                                 src="{{ placeholderImage() }}"
                                 data-src="{{ gear.getLocalImagePath() }}"
                                 alt="{{ gear.getName() }}"/>
                        </div>
                        <div class="min-w-0 flex items-center">
                            {% if gearIdsThatHaveDueTasks.has(gear.getId()) %}
                                <span class="flex shrink-0 size-2 me-2 bg-red-500 rounded-full animate-pulse" title="{{ "One of your gear maintenance tasks is due"|trans }}"></span>
                            {% endif %}
                            <div class="text-sm font-medium text-gray-900 truncate">{{ gear.getName() }}</div>
                        </div>
                        <div class="text-sm font-bold text-gray-900">{{ gear.getDistance()|renderMeasurement(0) }}</div>
                        <div class="hidden lg:block text-sm text-gray-500 truncate">
                            {{ componentsAttachedToGear|map(component => component.getLabel())|join(', ') }}
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-gray-400 transition-transform group-open/row:rotate-180" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m1 1 4 4 4-4"/>
                        </svg>
                    </summary>
                    <div class="px-8 py-5 border-t border-gray-100">
                        <div class="grid gap-2">
                            {% for gearComponent in componentsAttachedToGear %}
                                <div class="flex items-center bg-white border border-gray-200 rounded-lg shadow-sm">
                                    <div class="relative w-48 h-full">
                                        <img class="absolute inset-0 lazy object-cover size-full rounded-t-lg md:rounded-none md:rounded-s-lg"
                                             src="{{ placeholderImage() }}"
                                             data-src="{{ relativeUrl('/' ~ gearComponent.getLocalImagePath()) }}"
                                             alt="{{ gearComponent.getLabel() }}">
                                    </div>
                                    <div class="w-full flex flex-col justify-between p-4 leading-normal">
                                        <div class="flex items-center justify-between">
                                            <h5 class="mb-1 text-2xl font-bold tracking-tight text-gray-900">{{ gearComponent.getLabel() }}</h5>
                                            {% set componentPurchasePrice = gearComponent.getPurchasePrice() %}
                                            {% if componentPurchasePrice %}
                                                <div class="text-gray-700 text-xs px-2">
                                                    {{ componentPurchasePrice|formatMoney }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="grid grid-cols-1 xl:grid-cols-2 gap-y-4 divide-x *:px-4 -mx-4 font-normal text-gray-700">
                                            {% for maintenanceTask in gearComponent.getMaintenanceTasks() %}
                                                {% set maintenanceTaskStatus = maintenanceTaskStatuses.getForTask(maintenanceTask.getId()) %}
                                                <div class="flex flex-col">
                                                    <div class="flex justify-between">
                                                        <div>
                                                            {{ "{maintenanceTaskLabel} every {interval}"|trans({
                                                                '{maintenanceTaskLabel}': maintenanceTask.getLabel(),
                                                                '{interval}': maintenanceTask.getIntervalValue() ~ ' ' ~ maintenanceTask.getIntervalUnit().value
                                                            }) }}
                                                        </div>
                                                    </div>
                                                    <span class="text-xs grow">
                                                            {{ "Last maintenance"|trans }}:
                                                            {% if maintenanceTaskStatus.getLastPerformedOn() is not null %}
                                                                {{ maintenanceTaskStatus.getLastPerformedOn()|formatDate('normal') }}
                                                            {% else %}
                                                                {{ "never"|trans }}
                                                            {% endif %}
                                                        </span>
                                                    {% set progress = maintenanceTaskStatus.getProgress() %}
                                                    {% if progress is null %}
                                                        {% set colors = {'bg':'bg-gray-200','text':'text-gray-700'} %}
                                                    {% elseif progress.isOverdue() %}
                                                        {% set colors = {'bg':'bg-red-600', 'text':'text-red-600'} %}
                                                    {% elseif progress.isZero() %}
                                                        {% set colors = {'bg':'bg-gray-200','text':'text-gray-700'} %}
                                                    {% elseif progress.isLow() %}
                                                        {% set colors = {'bg':'bg-green-600','text':'text-green-600'} %}
                                                    {% elseif progress.isMedium() %}
                                                        {% set colors = { 'bg':'bg-yellow-400','text':'text-yellow-600'} %}
                                                    {% elseif progress.isHigh() %}
                                                        {% set colors = {'bg':'bg-red-600', 'text':'text-red-600'} %}
                                                    {% endif %}
                                                    <div class="mt-2">
                                                        <div class="flex items-center justify-between mb-1">
                                                            <span class="{{ colors.text }} text-sm font-medium">{{ progress ? progress.getDescription() : '0' }}</span>
                                                            {% if progress %}
                                                                <span class="{{ colors.text }} text-xs font-medium">
                                                                    {% if progress.isOverdue() %}
                                                                        {{ "Overdue by {amount}"|trans({'{amount}': progress.getRemainingDescription()}) }}
                                                                    {% else %}
                                                                        {{ "{amount} left"|trans({'{amount}': progress.getRemainingDescription()}) }}
                                                                    {% endif %}
                                                                </span>
                                                            {% endif %}
                                                        </div>
                                                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                                                            <div class="{{ colors.bg }} h-2.5 rounded-full"
                                                                 style="width: {{ progress ? progress.getPercentage() : 0 }}%"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </details>
            {% endfor %}
        </div>
    {% endautoescape %}
{% endblock %}