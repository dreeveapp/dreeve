{% autoescape false %}
    <ul class="tabs tabs--menu-item">
        <li>
            <a href="{{ relativeUrl(path('gear')) }}"
               class="{{ activeMenuItem == 'gear' ? 'active' : '' }}">
                {{ "Gear"|trans }}
            </a>
        </li>
        <li>
            <a href="{{ relativeUrl(path('gear_maintenance')) }}"
               class="flex items-center {{ activeMenuItem == 'gearMaintenance' ? 'active' : '' }}">
                <div class="contents" data-async-content-url="{{ relativeUrl(path('gear_maintenance_due')) }}"></div>
                {{ "Maintenance"|trans }}
            </a>
        </li>
        <li>
            <a href="{{ relativeUrl(path('gear_recording_devices')) }}"
               class="{{ activeMenuItem == 'recordingDevices' ? 'active' : '' }}">
                {{ "Recording devices"|trans }}
            </a>
        </li>
    </ul>
{% endautoescape %}