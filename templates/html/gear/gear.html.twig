<div class="flex items-center justify-between mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
        'url': 'gear',
        'label': 'Gear'|trans
    }], 'disableMargin': true} %}
    {% include 'html/navigation/admin-edit-link.html.twig' with {
        path: 'admin/gear',
        redirectTo: 'gear',
        title: "Manage gear"|trans,
        label: "Manage"|trans({}, 'admin')
    } %}
</div>
{% autoescape false %}
    <!-- GEAR SUB MENU -->
    {% include 'html/gear/gear-sub-menu.html.twig' with {activeMenuItem: 'gear'} %}
    <!-- GEAR -->
    {% if gearInUse|length > 0 %}
        <div class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <div class="mb-4 flex items-center gap-2">
                <h3 class="text-lg font-semibold">{{ "Active gear"|trans }}</h3>
                <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">{{ gearInUse|length }}</span>
            </div>
            <div class="grid items-center gap-x-4 grid-cols-[minmax(0,1fr)_6rem_0.75rem] lg:grid-cols-[minmax(0,1fr)_6rem_9rem_9rem_7rem_0.75rem] px-4 py-3 bg-gray-50 text-gray-500 text-xxs uppercase font-semibold">
                <div>{{ "Gear"|trans }}</div>
                <div>{{ "Distance"|trans }}</div>
                <div class="hidden lg:block">{{ "Moving time"|trans }}</div>
                <div class="hidden lg:block">{{ "Last 12 months"|trans }}</div>
                <div class="hidden lg:block">{{ "Last used"|trans }}</div>
                <div></div>
            </div>
            {% for gear in gearInUse %}
                {{ _self.gearRow(gear, gearUsage.getFor(gear.getId()), totalMovingTime, lastTwelveMonths, unitSystem) }}
            {% endfor %}
        </div>
    {% endif %}
    <!-- RETIRED GEAR -->
    {% if retiredGear|length > 0 %}
        <details class="group/section p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <summary class="list-none cursor-pointer flex items-center justify-between select-none">
                <div class="flex items-center gap-2">
                    <h3 class="text-lg font-semibold">{{ "Retired"|trans }}</h3>
                    <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">{{ retiredGear|length }}</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-gray-400 transition-transform group-open/section:rotate-180" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m1 1 4 4 4-4"/>
                </svg>
            </summary>
            <div class="mt-4 grid items-center gap-x-4 grid-cols-[minmax(0,1fr)_6rem_0.75rem] lg:grid-cols-[minmax(0,1fr)_6rem_9rem_9rem_7rem_0.75rem] px-4 py-3 bg-gray-50 text-gray-500 text-xxs uppercase font-semibold">
                <div>{{ "Gear"|trans }}</div>
                <div>{{ "Distance"|trans }}</div>
                <div class="hidden lg:block">{{ "Moving time"|trans }}</div>
                <div class="hidden lg:block">{{ "Last 12 months"|trans }}</div>
                <div class="hidden lg:block">{{ "Last used"|trans }}</div>
                <div></div>
            </div>
            <div>
                {% for gear in retiredGear %}
                    {{ _self.gearRow(gear, gearUsage.getFor(gear.getId()), totalMovingTime, lastTwelveMonths, unitSystem) }}
                {% endfor %}
            </div>
        </details>
    {% endif %}
    <!-- GEAR CHARTS -->
    <div class="grid grid-cols-1 mb-4">
        <!-- DISTANCE PER MONTH PER GEAR -->
        <div class="mb-4  p-4 bg-white border border-gray-200 rounded-lg shadow-xs ">
            <div class="mb-4 flex items-center">
                <h3 class="text-lg font-semibold">
                    {{ "Distance per month per gear"|trans }}
                </h3>
            </div>
            <div class="relative overflow-x-auto">
                <div class="h-96" data-echarts-options='{{ distancePerMonthPerGearChart }}'></div>
            </div>
        </div>
        <!-- DISTANCE OVER TIME PER GEAR -->
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <div class="mb-4 flex items-center">
                <h3 class="text-lg font-semibold">
                    {{ "Distance over time per gear"|trans }}
                </h3>
                <button data-popover-target="popover-distance-overtime" data-popover-placement="right" type="button">
                    <svg class="size-4 ml-1 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
                    <span class="sr-only">{{ "Show information"|trans }}</span>
                </button>
                <div data-popover id="popover-distance-overtime" role="tooltip" class="w-50 lg:w-md inline-block text-sm">
                    <p class="p-3">
                        {{ "Gear that is retired is disabled by default."|trans }}
                    </p>
                </div>
            </div>
            <div class="relative overflow-x-auto">
                <div class="h-96" data-echarts-options='{{ distanceOverTimePerGear }}'></div>
            </div>
        </div>
    </div>
{% endautoescape %}

{% macro gearRow(gear, usage, totalMovingTime, lastTwelveMonths, unitSystem) %}
    {% autoescape false %}
        {% include 'html/gear/_usage-row.html.twig' with {
            name: gear.getOriginalName(),
            subtitle: usage.getSportTypes()|map(sportType => sportType|trans)|join(', ') ~ ' · ' ~ gear.getNumberOfActivities() ~ ' ' ~ "workouts"|trans,
            distance: gear.getDistance(),
            movingTime: gear.getMovingTimeInHours().toFloat()|formatNumber(0) ~ '<span class="text-xxs ml-px">h</span>',
            shareOfMovingTime: totalMovingTime.toInt() > 0 ? gear.getMovingTime().toInt() / totalMovingTime.toInt() * 100 : 0,
            monthlyDistances: usage.getDistancesFor(lastTwelveMonths),
            lastUsedOn: usage.getLastUsedOn(),
            usageStats: [
                {label: "workouts"|trans, value: gear.getNumberOfActivities()|formatNumber(0)},
                {label: "Avg distance"|trans, value: gear.getAverageDistance()|renderMeasurement(0)},
                {label: "Elevation"|trans, value: gear.getElevation()|renderMeasurement(0)},
                {label: "Moving time"|trans, value: gear.getMovingTimeFormatted()},
                {label: "Avg speed"|trans, value: gear.getAverageSpeed()|renderMeasurement(1)},
                {label: "Calories"|trans, value: gear.getTotalCalories()|formatNumber(0) ~ '<span class="text-xxs ml-px">kcal</span>'},
            ],
            purchasePrice: gear.getPurchasePrice(),
            relativeCostPerDistanceUnit: gear.getRelativeCostPerDistanceUnit(unitSystem),
            relativeCostPerHour: gear.getRelativeCostPerHour(),
            relativeCostPerWorkout: gear.getRelativeCostPerWorkout()
        } only %}
    {% endautoescape %}
{% endmacro %}
