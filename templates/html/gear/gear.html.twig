<div class="flex items-center justify-between mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
        'url': 'gear',
        'label': 'Gear'|trans
    }], 'disableMargin': true} %}
    {% include 'html/navigation/admin-edit-link.html.twig' with {
        path: 'admin/gear',
        redirectTo: 'gear',
        title: "Manage gear"|trans,
        label: "Manage"|trans({}, 'admin')
    } %}
</div>
{% autoescape false %}
    <!-- GEAR SUB MENU -->
    {% include 'html/gear/gear-sub-menu.html.twig' with {activeMenuItem: 'gear'} %}
    <!-- GEAR SUMMARY -->
    {% include 'html/gear/_usage-summary.html.twig' with {
        label: "Gear"|trans,
        numberOfItems: gearInUse|length + idleGear|length + retiredGear|length,
        breakdown: [
            "{count} in use"|trans({'{count}': gearInUse|length}),
            "{count} idle"|trans({'{count}': idleGear|length}),
            "{count} retired"|trans({'{count}': retiredGear|length}),
        ],
        totalDistance: totalDistance,
        totalMovingTime: totalMovingTime,
        totalNumberOfWorkouts: totalNumberOfWorkouts
    } %}
    <!-- GEAR GROUPS -->
    {% for group in [
        {title: "In use"|trans, gear: gearInUse, isOpen: true},
        {title: "Idle"|trans, gear: idleGear, isOpen: false},
        {title: "Retired"|trans, gear: retiredGear, isOpen: false},
    ] %}
        {% if group.gear|length > 0 %}
            {% set rows %}
                {% for gear in group.gear %}
                    {{ _self.gearRow(gear, gearUsage.getFor(gear.getId()), totalDistance, maxDistance, lastTwelveMonths, unitSystem) }}
                {% endfor %}
            {% endset %}
            {% include 'html/gear/_usage-group.html.twig' with {
                title: group.title,
                numberOfItems: group.gear|length,
                nameLabel: "Gear"|trans,
                isOpen: group.isOpen,
                rows: rows
            } %}
        {% endif %}
    {% endfor %}
    <!-- GEAR CHARTS -->
    <div class="grid grid-cols-1 mb-4">
        <!-- DISTANCE PER MONTH PER GEAR -->
        <div class="mb-4  p-4 bg-white border border-gray-200 rounded-lg shadow-xs ">
            <div class="mb-4 flex items-center">
                <h3 class="text-lg font-semibold">
                    {{ "Distance per month per gear"|trans }}
                </h3>
                <button data-popover-target="popover-distance-per-month" data-popover-placement="right" type="button">
                    <svg class="size-4 ml-1 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
                    <span class="sr-only">{{ "Show information"|trans }}</span>
                </button>
                <div data-popover id="popover-distance-per-month" role="tooltip" class="w-50 lg:w-md inline-block text-sm">
                    <p class="p-3">
                        {{ "Gear that hasn't been used in the last three months, is disabled by default."|trans }}
                    </p>
                </div>
            </div>
            <div class="relative overflow-x-auto">
                <div class="h-96" data-echarts-options='{{ distancePerMonthPerGearChart }}'></div>
            </div>
        </div>
        <!-- DISTANCE OVER TIME PER GEAR -->
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <div class="mb-4 flex items-center">
                <h3 class="text-lg font-semibold">
                    {{ "Distance over time per gear"|trans }}
                </h3>
                <button data-popover-target="popover-distance-overtime" data-popover-placement="right" type="button">
                    <svg class="size-4 ml-1 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
                    <span class="sr-only">{{ "Show information"|trans }}</span>
                </button>
                <div data-popover id="popover-distance-overtime" role="tooltip" class="w-50 lg:w-md inline-block text-sm">
                    <p class="p-3">
                        {{ "Gear that is retired is disabled by default."|trans }}
                    </p>
                </div>
            </div>
            <div class="relative overflow-x-auto">
                <div class="h-96" data-echarts-options='{{ distanceOverTimePerGear }}'></div>
            </div>
        </div>
    </div>
{% endautoescape %}

{% macro gearRow(gear, usage, totalDistance, maxDistance, lastTwelveMonths, unitSystem) %}
    {% autoescape false %}
        {% set monthlyDistances = [] %}
        {% for month in lastTwelveMonths %}
            {% set monthlyDistances = monthlyDistances|merge([{label: month.getShortLabel(), distance: usage.getDistanceFor(month)}]) %}
        {% endfor %}
        {% include 'html/gear/_usage-row.html.twig' with {
            name: gear.getOriginalName(),
            subtitle: usage.getSportTypes()|map(sportType => sportType|trans)|join(', ') ~ ' · ' ~ gear.getNumberOfActivities() ~ ' ' ~ "workouts"|trans,
            distance: gear.getDistance(),
            shareOfDistance: totalDistance.toFloat() > 0 ? gear.getDistance().toFloat() / totalDistance.toFloat() * 100 : 0,
            relativeDistance: maxDistance.toFloat() > 0 ? gear.getDistance().toFloat() / maxDistance.toFloat() * 100 : 0,
            monthlyDistances: monthlyDistances,
            lastUsedOn: usage.getLastUsedOn(),
            usageStats: [
                {label: "workouts"|trans, value: gear.getNumberOfActivities()|formatNumber(0)},
                {label: "Avg distance"|trans, value: gear.getAverageDistance()|renderMeasurement(0)},
                {label: "Elevation"|trans, value: gear.getElevation()|renderMeasurement(0)},
                {label: "Moving time"|trans, value: gear.getMovingTimeFormatted()},
                {label: "Avg speed"|trans, value: gear.getAverageSpeed()|renderMeasurement(1)},
                {label: "Calories"|trans, value: gear.getTotalCalories()|formatNumber(0) ~ '<span class="text-xxs ml-px">kcal</span>'},
            ],
            purchasePrice: gear.getPurchasePrice(),
            relativeCostPerDistanceUnit: gear.getRelativeCostPerDistanceUnit(unitSystem),
            relativeCostPerHour: gear.getRelativeCostPerHour(),
            relativeCostPerWorkout: gear.getRelativeCostPerWorkout(),
            activitiesUrl: filteredUrl(path('activities'), {gear: gear.getId()})
        } only %}
    {% endautoescape %}
{% endmacro %}
