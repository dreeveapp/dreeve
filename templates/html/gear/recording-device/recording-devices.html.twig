<div class="flex items-center justify-between mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [
        {
            'url': 'gear',
            'label': 'Gear'|trans
        },
        {
            'url': 'gear/recording-devices',
            'label': 'Recording devices'|trans
        }],
        'disableMargin': true} %}
    {% include 'html/navigation/admin-edit-link.html.twig' with {
        path: 'admin/gear/recording-devices',
        redirectTo: 'gear/recording-devices',
        title: "Manage recording devices"|trans,
        label: "Manage"|trans({}, 'admin')
    } %}
</div>
{% autoescape false %}
    <!-- GEAR SUB MENU -->
    {% include 'html/gear/gear-sub-menu.html.twig' with {activeMenuItem: 'recordingDevices'} %}
    <!-- RECORDING DEVICES -->
    <div class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
        <h3 class="mb-4 text-lg font-semibold">
            {{ "Recording devices"|trans }}
        </h3>
        <div class="grid items-center gap-x-4 grid-cols-[minmax(0,1fr)_6rem_0.75rem] lg:grid-cols-[minmax(0,1fr)_6rem_9rem_9rem_7rem_0.75rem] px-4 py-3 bg-gray-50 text-gray-500 text-xxs uppercase font-semibold">
            <div>{{ "Recording device"|trans }}</div>
            <div>{{ "Dist."|trans }}</div>
            <div class="hidden lg:block">{{ "Moving time"|trans }}</div>
            <div class="hidden lg:block">{{ "Last 12 months"|trans }}</div>
            <div class="hidden lg:block">{{ "Last used"|trans }}</div>
            <div></div>
        </div>
        {% for device in devices %}
            {{ _self.deviceRow(device, deviceUsage.getFor(device.getName()), totalMovingTime, lastTwelveMonths, unitSystem) }}
        {% endfor %}
    </div>
{% endautoescape %}

{% macro deviceRow(device, usage, totalMovingTime, lastTwelveMonths, unitSystem) %}
    {% autoescape false %}
        {% include 'html/gear/_usage-row.html.twig' with {
            name: device.getName(),
            subtitle: usage.getSportTypes()|map(sportType => sportType|trans)|join(', ') ~ ' · ' ~ device.getNumberOfWorkouts() ~ ' ' ~ "workouts"|trans,
            distance: device.getDistanceTracked(),
            movingTime: device.getTimeTracked().toHour().toFloat()|formatNumber(0) ~ '<span class="text-xxs ml-px">h</span>',
            shareOfMovingTime: totalMovingTime.toInt() > 0 ? device.getTimeTracked().toInt() / totalMovingTime.toInt() * 100 : 0,
            monthlyDistances: usage.getDistancesFor(lastTwelveMonths),
            lastUsedOn: usage.getLastUsedOn(),
            usageStats: [
                {label: "workouts"|trans, value: device.getNumberOfWorkouts()|formatNumber(0)},
                {label: "Elev."|trans, value: device.getElevationTracked()|renderMeasurement(0)},
                {label: "Moving time"|trans, value: device.getTimeTrackedFormatted()},
            ],
            purchasePrice: device.getPurchasePrice(),
            relativeCostPerDistanceUnit: device.getRelativeCostPerDistanceUnit(unitSystem),
            relativeCostPerHour: device.getRelativeCostPerHour(),
            relativeCostPerWorkout: device.getRelativeCostPerWorkout()
        } only %}
    {% endautoescape %}
{% endmacro %}
