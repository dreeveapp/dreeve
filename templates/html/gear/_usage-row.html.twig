{% autoescape false %}
    <details class="group/row border-t border-gray-100">
        <summary class="grid items-center gap-x-4 grid-cols-[minmax(0,1fr)_6rem_0.75rem] lg:grid-cols-[minmax(0,1fr)_11rem_7rem_0.75rem] list-none cursor-pointer px-4 py-2.5 hover:bg-gray-50 select-none">
            <div class="min-w-0">
                <div class="font-medium text-gray-900 truncate">{{ name }}</div>
                <div class="text-xs text-gray-500 truncate">{{ subtitle }}</div>
            </div>
            <div>
                <div class="flex items-baseline justify-between gap-2">
                    <span class="text-sm font-bold text-gray-900">{{ distance|renderMeasurement(0) }}</span>
                    <span class="hidden lg:inline text-xs text-gray-500 tabular-nums">{{ shareOfDistance|formatNumber(0) }}%</span>
                </div>
                <div class="mt-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div class="h-full bg-primary rounded-full" style="width: {{ relativeDistance|round(1) }}%"></div>
                </div>
            </div>
            <div class="hidden lg:block text-sm text-gray-500">{{ lastUsedOn|formatDate('short') }}</div>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-gray-400 transition-transform group-open/row:rotate-180" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m1 1 4 4 4-4"/>
            </svg>
        </summary>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 px-4 py-4 border-t border-gray-100 bg-gray-50">
            <div>
                <div class="mb-2 text-xs font-semibold text-gray-700">{{ "Usage"|trans }}</div>
                <div class="grid grid-cols-3 gap-x-2 gap-y-3">
                    {% for stat in usageStats %}
                        <div>
                            <div class="text-xxs uppercase text-gray-400 tracking-wider">{{ stat.label }}</div>
                            <div class="text-sm font-bold text-gray-900">{{ stat.value }}</div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div>
                <div class="mb-2 text-xs font-semibold text-gray-700">{{ "Cost"|trans }}</div>
                {% if purchasePrice %}
                    <div class="grid grid-cols-2 gap-x-2 gap-y-3">
                        <div>
                            <div class="text-xxs uppercase text-gray-400 tracking-wider">{{ "Purchase price"|trans }}</div>
                            <div class="text-sm font-bold text-gray-900">{{ purchasePrice|formatMoney }}</div>
                        </div>
                        <div>
                            <div class="text-xxs uppercase text-gray-400 tracking-wider">{{ "per"|trans }} {{ renderUnitSymbol('distance') }}</div>
                            <div class="text-sm font-bold text-gray-900">{{ relativeCostPerDistanceUnit|formatMoney }}</div>
                        </div>
                        <div>
                            <div class="text-xxs uppercase text-gray-400 tracking-wider">{{ "per hour"|trans }}</div>
                            <div class="text-sm font-bold text-gray-900">{{ relativeCostPerHour|formatMoney }}</div>
                        </div>
                        <div>
                            <div class="text-xxs uppercase text-gray-400 tracking-wider">{{ "per activity"|trans }}</div>
                            <div class="text-sm font-bold text-gray-900">{{ relativeCostPerWorkout|formatMoney }}</div>
                        </div>
                    </div>
                {% else %}
                    <div class="text-xs text-gray-500">{{ "No purchase price set"|trans }}</div>
                {% endif %}
            </div>
            <div class="lg:col-span-2">
                <a href="{{ activitiesUrl }}" class="text-xs font-medium text-blue-600 hover:underline">{{ "View activities"|trans }}</a>
            </div>
        </div>
    </details>
{% endautoescape %}
