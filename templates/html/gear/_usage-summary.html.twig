{% autoescape false %}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 my-4">
        <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xxs uppercase tracking-wider font-semibold text-gray-500">{{ label }}</span>
                <div class="size-6 rounded-md bg-primary-soft text-primary flex items-center justify-center">
                    {{ svg('cog', 'size-3.5') }}
                </div>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-black tracking-tight text-gray-900">{{ numberOfItems }}</span>
            </div>
            <div class="text-xs text-gray-500 truncate">{{ breakdown|join(' · ') }}</div>
        </div>
        <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xxs uppercase tracking-wider font-semibold text-gray-500">{{ "Distance"|trans }}</span>
                <div class="size-6 rounded-md bg-primary-soft text-primary flex items-center justify-center">
                    {{ svg('distance', 'size-3.5') }}
                </div>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-black tracking-tight text-gray-900">{{ totalDistance|formatMeasurement(0) }}</span>
                <span class="text-xs font-medium text-gray-500">{{ totalDistance|measurementSymbol }}</span>
            </div>
        </div>
        <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xxs uppercase tracking-wider font-semibold text-gray-500">{{ "Moving time"|trans }}</span>
                <div class="size-6 rounded-md bg-primary-soft text-primary flex items-center justify-center">
                    {{ svg('time', 'size-3.5') }}
                </div>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-black tracking-tight text-gray-900">{{ totalMovingTime.toHour().toFloat()|formatNumber(0) }}</span>
                <span class="text-xs font-medium text-gray-500">h</span>
            </div>
        </div>
        <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xxs uppercase tracking-wider font-semibold text-gray-500">{{ "workouts"|trans }}</span>
                <div class="size-6 rounded-md bg-primary-soft text-primary flex items-center justify-center">
                    {{ svg('hashtag', 'size-3.5') }}
                </div>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-black tracking-tight text-gray-900">{{ totalNumberOfWorkouts|formatNumber(0) }}</span>
            </div>
        </div>
    </div>
{% endautoescape %}
