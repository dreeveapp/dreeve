{% autoescape false %}
    <div class="flex items-center justify-between gap-4 mb-4">
        {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [], 'disableMargin': true} %}
        {% if isAuthenticated %}
            <a href="{{ relativeUrlWithRedirectTo('admin/settings/dashboard', 'dashboard') }}" class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-600 hover:text-gray-900 bg-white hover:bg-gray-50 border border-gray-200 shadow-xs rounded-lg px-3 py-1.5 transition" title="{{ "Edit dashboard"|trans }}">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/>
                </svg>
                {{ "Edit"|trans({}, 'admin') }}
            </a>
        {% endif %}
    </div>
{% endautoescape %}
{% set colSpanMap = {
    33: 'xl:col-span-2',
    50: 'xl:col-span-3',
    66: 'xl:col-span-4',
    100: 'xl:col-span-6'
} %}
{% autoescape false %}
    <div class="grid grid-cols-1 xl:grid-cols-6 gap-4 mb-4">
        {% for configuredWidget in configuredWidgets %}
            <div data-fullscreen-content
                 data-widget-id="{{ configuredWidget.getId() }}"
                 data-async-content-url="{{ fragmentPartialUrl('dashboard/widget/' ~ configuredWidget.getId()) }}"
                 class="{{ colSpanMap[configuredWidget.getWidth()] }} flex flex-col p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
                <div class="flex h-full min-h-16 flex-col justify-center gap-2 rounded-md border border-dashed border-gray-200 bg-gray-50/60 px-3 py-3 animate-pulse">
                    <div class="h-2 w-1/3 rounded bg-gray-200"></div>
                    <div class="h-2 w-2/3 rounded bg-gray-200"></div>
                    <div class="h-2 w-1/2 rounded bg-gray-200"></div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endautoescape %}
