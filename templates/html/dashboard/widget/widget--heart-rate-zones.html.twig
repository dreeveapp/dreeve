{% autoescape false %}
    <div class="flex items-center mb-4">
        <h3 class="text-lg font-semibold">
            {{ widgetTitle|e }}
        </h3>
        <button type="button" data-fullscreen-trigger class="fullscreen-enabled:hidden ml-auto self-start cursor-pointer">
            {{ svg('expand') }}
            <span class="sr-only">{{ "Enter fullscreen mode"|trans }}</span>
        </button>
    </div>
    {% if relativeHeartRateDistributionChart %}
        <div class="grow h-72" data-echarts-options='{{ relativeHeartRateDistributionChart }}'></div>
    {% else %}
        <div class="grow flex items-center justify-center h-72 text-gray-500">{{ "No data available"|trans }}</div>
    {% endif %}
{% endautoescape %}
