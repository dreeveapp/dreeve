<div class="flex items-center justify-between gap-4 mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [
        {
            'url': 'dashboard/power-output',
            'label': 'Peak power outputs'|trans
        }], 'disableMargin': true} %}
</div>
{% autoescape false %}
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-4">
        <div class="mb-4 flex items-center justify-between">
            <h1 class="flex items-center text-lg font-semibold text-gray-900">
            <span>{{ "Peak power outputs"|trans }}</span>
            </h1>
        </div>
        {% if bestPowerOutputsPerActivityType|length > 1 %}
            <div class="tabs tabs--default">
                <ul id="powerOutputDetailsActivityTypeTab" data-tabs="#powerOutputDetailsActivityTypeTabContent" role="tablist">
                    {% for activityType in bestPowerOutputsPerActivityType|keys %}
                        <li role="presentation">
                            <a href="#" data-tabs-target="#powerOutputDetails{{ activityType }}" role="tab"
                               aria-controls="powerOutputDetails{{ activityType }}">
                                {{ activityTypeFrom(activityType)|trans }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
        <div id="powerOutputDetailsActivityTypeTabContent">
            {% for activityType,bestPowerOutputs in bestPowerOutputsPerActivityType %}
                <div id="powerOutputDetails{{ activityType }}" role="tabpanel"
                     aria-labelledby="powerOutputDetails{{ activityType }}-tab">
                    <div class="grid grid-cols-1 gap-4">
                        <div class="h-80" data-echarts-options='{{ powerOutputChartsPerActivityType[activityType] }}'></div>
                        <div>
                            <h3 class="mb-4 font-semibold">
                                {{ "Details"|trans }}
                            </h3>
                            <div class="relative overflow-x-auto">
                                <table class="data-table">
                                    <thead class="z-10 sticky top-0">
                                    <tr>
                                        <th scope="col" class="bg-gray-50 sticky left-0">
                                            <div class="w-24">&nbsp;</div>
                                        </th>
                                        {% for timeIntervalLabel in timeIntervalsToDisplay %}
                                            <th scope="col" colspan="2">
                                                {{ "Best"|trans }} {{ timeIntervalLabel }}
                                            </th>
                                        {% endfor %}
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for bestPowerOutput in bestPowerOutputs %}
                                        {% set description = bestPowerOutput[0] %}
                                        {% set powerOutputs = bestPowerOutput[1] %}
                                        <tr class="group/row">
                                            <td class="font-medium bg-white text-gray-900 sticky left-0">
                                                {{ description }}
                                            </td>
                                            {% for timeIntervalInSeconds in timeIntervalsToDisplay|keys %}
                                                {% set powerOutput = powerOutputs.findByTimeInterval(timeIntervalInSeconds) %}
                                                <td>
                                                    {{ powerOutput ? powerOutput.getPower() ~ '<span class="text-xxs ml-px">w</span>' : '-' }}
                                                </td>
                                                <td class="border-r-2">
                                                    {{ powerOutput and powerOutput.getRelativePower() ? powerOutput.getRelativePower() ~ '<span class="text-xxs ml-px">w/kg</span>' : '-' }}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endautoescape %}