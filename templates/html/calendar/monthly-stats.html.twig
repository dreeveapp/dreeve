{% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
    'url': 'monthly-stats',
    'label': 'Monthly stats'|trans
}]} %}
{% autoescape false %}
    <!-- MONTHLY STATS -->
    {% for year in years %}
        <details class="group/section p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-xs" {{ year.isCurrent ? 'open' : '' }}>
            <summary class="list-none cursor-pointer flex items-center justify-between gap-4 select-none">
                <div class="flex items-center gap-2">
                    <h3 class="text-lg font-semibold">{{ year.year }}</h3>
                    <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">{{ year.totals.numberOfActivities }} {{ "workouts"|trans }}</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="hidden sm:flex items-baseline gap-4 text-sm font-bold text-gray-900">
                        <span>{{ year.totals.distance|renderMeasurement(0) }}</span>
                        <span>{{ year.totals.movingTime|formatSeconds }}</span>
                        <span class="hidden lg:inline">{{ year.totals.elevation|renderMeasurement(0) }}</span>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-gray-400 transition-transform group-open/section:rotate-180" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m1 1 4 4 4-4"/>
                    </svg>
                </div>
            </summary>
            <div class="mt-4 grid items-center gap-x-4 grid-cols-[minmax(0,1fr)_6rem_0.75rem] lg:grid-cols-[minmax(0,1fr)_6rem_8rem_6rem_12rem_0.75rem] px-4 py-3 bg-gray-50 text-gray-500 text-xxs uppercase font-semibold">
                <div>{{ "Month"|trans }}</div>
                <div>{{ "Dist."|trans }}</div>
                <div class="hidden lg:block">{{ "Moving time"|trans }}</div>
                <div class="hidden lg:block">{{ "Elev."|trans }}</div>
                <div class="hidden lg:block">{{ "Active days"|trans }}</div>
                <div></div>
            </div>
            <div>
                {% for monthEntry in year.months %}
                    {% set month = monthEntry.month %}
                    {% set stats = monthEntry.stats %}
                    <details class="group/row border-t border-gray-100">
                        <summary class="grid items-center gap-x-4 grid-cols-[minmax(0,1fr)_6rem_0.75rem] lg:grid-cols-[minmax(0,1fr)_6rem_8rem_6rem_12rem_0.75rem] list-none cursor-pointer px-4 py-2.5 hover:bg-gray-50 select-none">
                            <div class="min-w-0">
                                <div class="text-sm truncate">
                                    <a href="{{ relativeUrl(path('monthly_stats_month', {'month': month.getId()})) }}" class="font-medium text-blue-600 hover:underline">{{ month.getLabelWithoutYear() }}</a>
                                </div>
                                <div class="text-xs text-gray-500 truncate">{{ stats.numberOfActivities }} {{ "workouts"|trans }}</div>
                            </div>
                            <div class="text-sm font-bold text-gray-900">{{ stats.distance|renderMeasurement(0) }}</div>
                            <div class="hidden lg:block text-sm font-bold text-gray-900" title="{{ stats.movingTime.toHour().toFloat()|formatNumber(1) }}h">{{ stats.movingTime|formatSeconds }}</div>
                            <div class="hidden lg:block text-sm font-bold text-gray-900">{{ stats.elevation|renderMeasurement(0) }}</div>
                            <div class="hidden lg:flex items-center gap-2">
                                <div class="flex-1 flex gap-px">
                                    {% for day in monthEntry.days %}
                                        <div class="flex-1 h-4 rounded-xs {{ day.state == 'active' ? 'bg-primary' : (day.state == 'upcoming' ? 'bg-gray-100' : 'bg-gray-200') }}" title="{{ month.getShortLabelWithoutYear() }} {{ day.dayNumber }}"></div>
                                    {% endfor %}
                                </div>
                                <span class="w-9 text-right text-xs text-gray-500 tabular-nums">{{ monthEntry.numberOfActiveDays }}/{{ monthEntry.days|length }}</span>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-gray-400 transition-transform group-open/row:rotate-180" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m1 1 4 4 4-4"/>
                            </svg>
                        </summary>
                        <div class="grid items-center gap-x-4 grid-cols-[minmax(0,1fr)_minmax(4rem,auto)_minmax(5rem,auto)] lg:grid-cols-[8rem_minmax(0,1fr)_minmax(5rem,auto)_minmax(6rem,auto)_minmax(6rem,auto)_minmax(6rem,auto)] px-8 py-5 border-t border-gray-100">
                            <div class="col-span-full grid grid-cols-subgrid items-center pb-1 text-xxs uppercase font-semibold text-gray-400 tracking-wider">
                                <div></div>
                                <div class="hidden lg:block"></div>
                                <div class="whitespace-nowrap"># {{ "workouts"|trans }}</div>
                                <div>{{ "Dist."|trans }}</div>
                                <div class="hidden lg:block">{{ "Elev."|trans }}</div>
                                <div class="hidden lg:block">{{ "Moving time"|trans }}</div>
                            </div>
                            <div class="col-span-full grid grid-cols-subgrid divide-y divide-gray-100">
                                {% for sportTypeEntry in monthEntry.sportTypes %}
                                    {% set sportTypeStats = sportTypeEntry.stats %}
                                    <div class="col-span-full grid grid-cols-subgrid items-center py-2">
                                        <div class="text-sm font-medium text-gray-900 truncate">{{ sportTypeEntry.sportType|trans }}</div>
                                        <div class="hidden lg:block w-full rounded-full bg-gray-200">
                                            {% if sportTypeEntry.shareOfMovingTime > 0 %}
                                                <div class="rounded-full bg-primary p-0.5 text-center text-xs leading-none font-medium text-white no-dark" style="width: {{ max(10, sportTypeEntry.shareOfMovingTime) }}%">
                                                    {{ sportTypeEntry.shareOfMovingTime }}%
                                                </div>
                                            {% else %}
                                                <div class="rounded-full p-0.5 text-center text-xs leading-none font-medium" style="width: 10%">
                                                    0%
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="text-sm font-bold text-gray-900">{{ sportTypeStats.numberOfActivities }}</div>
                                        <div class="text-sm font-bold text-gray-900">{{ sportTypeStats.distance|renderMeasurement(0) }}</div>
                                        <div class="hidden lg:block text-sm font-bold text-gray-900">{{ sportTypeStats.elevation|renderMeasurement(0) }}</div>
                                        <div class="hidden lg:block text-sm font-bold text-gray-900" title="{{ sportTypeStats.movingTime.toHour().toFloat()|formatNumber(1) }}h">{{ sportTypeStats.movingTime|formatSeconds }}</div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </details>
                {% endfor %}
            </div>
        </details>
    {% endfor %}
{% endautoescape %}
