{% autoescape false %}
    {% if isActiveNavItem({'/admin/gear': false}) %}
        {% set inMaintenanceLog = isActiveNavItem({'/admin/gear/maintenance-logs': false}) %}
        {% set inMaintenanceConfig = isActiveNavItem({'/admin/gear/maintenance-config': false}) %}
        {% set inMaintenance = inMaintenanceLog or inMaintenanceConfig %}
        {% set inRecordingDevices = isActiveNavItem({'/admin/gear/recording-devices': false}) %}
        {% set inGearOverview = not inMaintenance and not inRecordingDevices %}
        <nav class="contextual-panel" aria-label="{{ "Gear"|trans }}">
            <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
                {{ "Gear"|trans }}
            </p>
            <ul class="space-y-1">
                <li>
                    <a href="{{ relativeUrl(path('admin_manage_gear_overview')) }}" {{ inGearOverview ? 'aria-selected="true"' : '' }}>
                        {{ "Gear"|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_manage_recording_devices_overview')) }}" {{ inRecordingDevices ? 'aria-selected="true"' : '' }}>
                        {{ "Recording devices"|trans }}
                    </a>
                </li>
            </ul>
            <p class="mt-4 px-2 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
                {{ "Maintenance"|trans }}
            </p>
            <ul class="space-y-1">
                <li>
                    <a href="{{ relativeUrl(path('admin_manage_gear_maintenance_logs_overview')) }}" {{ inMaintenanceLog ? 'aria-selected="true"' : '' }}>
                        {{ "Log"|trans({}, 'admin') }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_manage_gear_maintenance_config')) }}" {{ inMaintenanceConfig ? 'aria-selected="true"' : '' }}>
                        {{ "Configuration"|trans({}, 'admin') }}
                    </a>
                </li>
            </ul>
        </nav>
    {% endif %}
    {% if isActiveNavItem({'/admin/collections': false}) %}
        {% set inTripSuggestions = isActiveNavItem({'/admin/collections/suggestions': false}) %}
        <nav class="contextual-panel" aria-label="{{ "Activity collections"|trans }}">
            <p class="px-2 pb-3 text-xs font-semibold uppercase tracking-wide text-gray-400">
                {{ "Activity collections"|trans }}
            </p>
            <ul class="space-y-1">
                <li>
                    <a href="{{ relativeUrl(path('admin_manage_activity_collection_overview')) }}" {{ not inTripSuggestions ? 'aria-selected="true"' : '' }}>
                        {{ "Collections"|trans({}, 'admin') }}
                    </a>
                </li>
                <li>
                    {% set numberOfTripSuggestions = isActiveNavItem({'/admin/collections': true, '/admin/collections/suggestions': true}) ? number_of_trip_suggestions() : 0 %}
                    <a href="{{ relativeUrl(path('admin_activity_collection_trip_suggestions')) }}" {{ inTripSuggestions ? 'aria-selected="true"' : '' }}>
                        {{ "Suggested trips"|trans({}, 'admin') }}
                        {% if numberOfTripSuggestions > 0 %}
                            <span class="ms-auto shrink-0 bg-primary/15 text-primary text-xs font-medium px-2.5 py-0.5 rounded-full">{{ numberOfTripSuggestions }}</span>
                        {% endif %}
                    </a>
                </li>
            </ul>
        </nav>
    {% endif %}
    {% if isActiveNavItem({'/admin/automation-rules': false}) and importMode.isFiles() %}
        {% set inTestRules = isActiveNavItem({'/admin/automation-rules/test': false}) %}
        {% set inBackfill = isActiveNavItem({'/admin/automation-rules/backfill': false}) %}
        {% set inRules = not inTestRules and not inBackfill %}
        <nav class="contextual-panel" aria-label="{{ "Automation rules"|trans({}, 'admin') }}">
            <p class="px-2 pb-3 text-xs font-semibold uppercase tracking-wide text-gray-400">
                {{ "Automation rules"|trans({}, 'admin') }}
            </p>
            <ul class="space-y-1">
                <li>
                    <a href="{{ relativeUrl(path('admin_manage_automation_rules_overview')) }}" {{ inRules ? 'aria-selected="true"' : '' }}>
                        {{ "Rules"|trans({}, 'admin') }}
                    </a>
                </li>
                {% if has_enabled_automation_rules() %}
                    <li>
                        <a href="{{ relativeUrl(path('admin_test_automation_rules')) }}" {{ inTestRules ? 'aria-selected="true"' : '' }}>
                            {{ "Test rules"|trans({}, 'admin') }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ relativeUrl(path('admin_backfill_automation_rules')) }}" {{ inBackfill ? 'aria-selected="true"' : '' }}>
                            {{ "Apply to existing activities"|trans({}, 'admin') }}
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
    {% if isActiveNavItem({'/admin/settings': false}) %}
        {% set inGeneral = isActiveNavItem({'/admin/settings/general': false}) %}
        {% set inAthleteWeight = isActiveNavItem({'/admin/settings/athlete-weight': false}) %}
        {% set inAthleteFtp = isActiveNavItem({'/admin/settings/athlete-ftp': false}) %}
        {% set inAppearance = isActiveNavItem({'/admin/settings/appearance': false}) %}
        {% set inMaps = isActiveNavItem({'/admin/settings/maps': false}) %}
        {% set inImport = isActiveNavItem({'/admin/settings/import': false}) %}
        {% set inMetrics = isActiveNavItem({'/admin/settings/metrics': false}) %}
        {% set inZwift = isActiveNavItem({'/admin/settings/zwift': false}) %}
        {% set inIntegrations = isActiveNavItem({'/admin/settings/integrations': false}) %}
        {% set inDaemon = isActiveNavItem({'/admin/settings/daemon': false}) %}
        {% set inSecurity = isActiveNavItem({'/admin/settings/security': false}) %}
        {% set inDashboard = isActiveNavItem({'/admin/settings/dashboard': false}) %}
        <nav class="contextual-panel" aria-label="{{ "Settings"|trans({}, 'admin') }}">
            <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
                {{ "Athlete"|trans({}, 'admin') }}
            </p>
            <ul class="space-y-1">
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'general'})) }}" {{ inGeneral ? 'aria-selected="true"' : '' }}>
                        {{ "General"|trans({}, 'admin') }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'athlete-ftp'})) }}" {{ inAthleteFtp ? 'aria-selected="true"' : '' }}>
                        {{ "FTP history"|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'athlete-weight'})) }}" {{ inAthleteWeight ? 'aria-selected="true"' : '' }}>
                        {{ "Weight history"|trans }}
                    </a>
                </li>
            </ul>
            <p class="mt-4 px-2 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
                {{ "Display"|trans({}, 'admin') }}
            </p>
            <ul class="space-y-1">
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'appearance'})) }}" {{ inAppearance ? 'aria-selected="true"' : '' }}>
                        {{ "Appearance"|trans({}, 'admin') }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_settings_dashboard')) }}" {{ inDashboard ? 'aria-selected="true"' : '' }}>
                        {{ "Dashboard"|trans }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'metrics'})) }}" {{ inMetrics ? 'aria-selected="true"' : '' }}>
                        {{ "Metrics"|trans({}, 'admin') }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'maps'})) }}" {{ inMaps ? 'aria-selected="true"' : '' }}>
                        {{ "Maps"|trans({}, 'admin') }}
                    </a>
                </li>
            </ul>
            <p class="mt-4 px-2 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
                {{ "System"|trans({}, 'admin') }}
            </p>
            <ul class="space-y-1">
                {% if importMode.isStravaApi() %}
                    <li>
                        <a href="{{ relativeUrl(path('admin_settings', {'group': 'import'})) }}" {{ inImport ? 'aria-selected="true"' : '' }}>
                            {{ "Strava import"|trans({}, 'admin') }}
                        </a>
                    </li>
                {% endif %}
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'daemon'})) }}" {{ inDaemon ? 'aria-selected="true"' : '' }}>
                        {{ "Scheduled actions"|trans({}, 'admin') }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'integrations'})) }}" {{ inIntegrations ? 'aria-selected="true"' : '' }}>
                        {{ "Integrations"|trans({}, 'admin') }}
                    </a>
                </li>
            </ul>
            <ul class="mt-4 space-y-1 border-t border-gray-200 pt-4">
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'security'})) }}" {{ inSecurity ? 'aria-selected="true"' : '' }}>
                        {{ "Security"|trans({}, 'admin') }}
                    </a>
                </li>
                <li>
                    <a href="{{ relativeUrl(path('admin_settings', {'group': 'zwift'})) }}" {{ inZwift ? 'aria-selected="true"' : '' }}>
                        {{ "Zwift"|trans({}, 'admin') }}
                    </a>
                </li>
            </ul>
        </nav>
    {% endif %}
{% endautoescape %}
