{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% autoescape false %}
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
        <h3 class="text-lg font-semibold mb-4">
            {{ "Backups"|trans({}, 'admin') }}
        </h3>
        {% if not isOnMountedVolume %}
            {% set linkOpen = '<a class="font-semibold underline hover:no-underline" href="https://docs.dreeve.app/maintenance/backup-and-restore/#mount-the-backups-directory">' %}
            {% set linkClose = '</a>' %}
            <div class="alert alert--warning mb-4" role="alert">
                <span class="sr-only">{{ "Warning"|trans({}, 'admin') }}</span>
                <div>
                    {{ "The backups directory is not mounted as a volume. Backups will be lost when the container is recreated. See {linkOpen}the documentation{linkClose}."|trans({'{linkOpen}': linkOpen, '{linkClose}': linkClose}, 'admin')|raw }}
                </div>
            </div>
        {% endif %}
        <div class="relative overflow-x-auto">
            <table class="data-table">
                <thead>
                <tr>
                    <th scope="col" class="text-left">
                        {{ "Created on"|trans({}, 'admin') }}
                    </th>
                    <th scope="col" class="text-left">
                        {{ "Filename"|trans({}, 'admin') }}
                    </th>
                    <th scope="col" class="text-left">
                        {{ "Size"|trans({}, 'admin') }}
                    </th>
                    <th scope="col">
                        {{ "Activities"|trans }}
                    </th>
                    <th scope="col" class="text-left">
                        {{ "Version"|trans({}, 'admin') }}
                    </th>
                    <th scope="col" class="narrow sticky-actions">
                        <span class="sr-only">{{ "Actions"|trans({}, 'admin') }}</span>
                    </th>
                </tr>
                </thead>
                <tbody>
                {% for backup in backups %}
                    <tr class="group/row">
                        <td class="whitespace-nowrap text-left font-medium text-gray-800">
                            {{ backup.getCreatedOn()|formatDate() }}
                            <span class="text-xs">{{ backup.getCreatedOn()|formatTime(true) }}</span>
                        </td>
                        <td class="whitespace-nowrap text-left">
                            {{ backup.getFilename() }}
                        </td>
                        <td class="whitespace-nowrap text-left">
                            {{ backup.getSizeInMegaBytes()|formatNumber(1) }}<span class="text-xxs ml-px">MB</span>
                        </td>
                        {% set manifest = backup.getManifest() %}
                        <td class="whitespace-nowrap">
                            {% if manifest %}
                                <div class="flex flex-col gap-1">
                                    <span>{{ manifest.getNumberOfActivities() }}</span>
                                    {% if manifest.getNumberOfActivities() > 0 %}
                                        <span class="text-xs text-gray-500">{{ manifest.getFirstActivityStartDate()|formatDate() }} - {{ manifest.getLastActivityStartDate()|formatDate() }}</span>
                                    {% endif %}
                                </div>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td class="whitespace-nowrap text-left">
                            {% if manifest %}
                                <span class="pill pill--neutral text-xs">
                                    {{ manifest.getAppVersion() }}
                                </span>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td class="narrow whitespace-nowrap sticky-actions">
                            <div class="inline-flex items-center gap-2">
                                <a href="{{ relativeUrl(path('admin_download_backup', {filename: backup.getFilename()})) }}"
                                   class="inline-flex items-center justify-center text-gray-500 transition-colors hover:text-primary"
                                   title="{{ "Download backup"|trans({}, 'admin') }}">
                                    <span class="sr-only">{{ "Download backup"|trans({}, 'admin') }}</span>
                                    <svg class="size-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13V4M7 14H5a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1h-2m-1-5-4 5-4-5m9 8h.01"/>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="flex flex-col items-center justify-center gap-3 py-12 px-4 text-center">
                                <span class="grid place-items-center size-12 rounded-full bg-gray-100 text-gray-400" aria-hidden="true">
                                    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M10 12v1h4v-1m4 7H6a1 1 0 0 1-1-1V9h14v9a1 1 0 0 1-1 1ZM4 5h16a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
                                </span>
                                {% set linkOpen = '<a class="font-semibold underline hover:no-underline" href="https://docs.dreeve.app/maintenance/backup-and-restore/#make-a-backup">' %}
                                {% set linkClose = '</a>' %}
                                <div class="flex flex-col gap-1">
                                    <span class="text-sm font-medium text-gray-800">{{ "No backups yet."|trans({}, 'admin') }}</span>
                                    {% if isManaged %}
                                        <span class="text-xs text-gray-500">{{ "A backup is created automatically every night. Read more in {linkOpen}the documentation{linkClose}."|trans({'{linkOpen}': linkOpen, '{linkClose}': linkClose}, 'admin')|raw }}</span>
                                    {% else %}
                                        <span class="text-xs text-gray-500">{{ "Enable the local backup in the scheduled actions settings, or create one by hand as explained in {linkOpen}the documentation{linkClose}."|trans({'{linkOpen}': linkOpen, '{linkClose}': linkClose}, 'admin')|raw }}</span>
                                    {% endif %}
                                </div>
                                {% if not isManaged %}
                                    <a href="{{ relativeUrl(path('admin_settings', {group: 'daemon'})) }}" type="button" class="btn--primary mt-1">
                                        {{ "Go to scheduled actions"|trans({}, 'admin') }}
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endautoescape %}
{% endblock main %}
