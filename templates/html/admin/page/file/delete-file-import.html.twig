{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% embed 'html/admin/component/delete-confirm-modal.html.twig' with {closeUrl: redirectUrl(relativeUrl(path('admin_file_imports')))} %}
        {% block title %}{{ "Delete file import"|trans({}, 'admin') }}{% endblock %}
        {% block hidden_fields %}
            <input type="hidden" name="fileImportId" value="{{ fileImport.getFileImportId() }}">
        {% endblock %}
        {% block message %}
            {% autoescape false %}
            <p>
                {{ "Are you sure you want to delete the import of {name}?"|trans({
                    '{name}': '<span class="font-semibold text-gray-900">' ~ fileImport.getOriginalFilename() ~ '</span>'
                }, 'admin') }}
            </p>
            <p>
                {{ "This only removes the import record, the imported activity is kept."|trans({}, 'admin') }}
            </p>
            <p>
                {{ "This action cannot be undone."|trans({}, 'admin') }}
            </p>
            {% endautoescape %}
        {% endblock %}
    {% endembed %}
{% endblock main %}
