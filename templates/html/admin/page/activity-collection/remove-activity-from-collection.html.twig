{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% embed 'html/admin/component/delete-confirm-modal.html.twig' with {closeUrl: relativeUrl(path('admin_edit_activity_collection', {activityCollectionId: activityCollection.getId()}))} %}
        {% block title %}{{ "Remove activity"|trans({}, 'admin') }}{% endblock %}
        {% block hidden_fields %}
            <input type="hidden" name="activityCollectionId" value="{{ activityCollection.getId() }}">
            <input type="hidden" name="activityId" value="{{ activity.getId() }}">
        {% endblock %}
        {% block message %}
            {% autoescape false %}
            <p>
                {{ "Are you sure you want to remove {activity} from {activityCollection}?"|trans({
                    '{activity}': '<span class="font-semibold text-gray-900">' ~ activity.getName()|e ~ '</span>',
                    '{activityCollection}': '<span class="font-semibold text-gray-900">' ~ activityCollection.getName()|e ~ '</span>',
                }, 'admin') }}
            </p>
            <p>
                {{ "The activity itself is not deleted."|trans({}, 'admin') }}
            </p>
            {% endautoescape %}
        {% endblock %}
        {% block submit_label %}{{ "Remove"|trans({}, 'admin') }}{% endblock %}
        {% block submit_loading_label %}{{ "Removing..."|trans({}, 'admin') }}{% endblock %}
    {% endembed %}
{% endblock main %}
