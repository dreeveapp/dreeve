{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set editUrl = relativeUrlWithRedirectTo(path('admin_edit_activity_collection', {activityCollectionId: activityCollection.getId()}), redirectUrl(relativeUrl(path('admin_manage_activity_collection_overview')))) %}
    {% embed 'html/admin/component/modal.html.twig' with {closeUrl: editUrl} %}
        {% block title %}{{ "Add activity to {activityCollection}"|trans({'{activityCollection}': activityCollection.getName()}, 'admin') }}{% endblock %}
        {% block body %}
            <form data-dispatch-command="{{ dispatchCommand }}" data-redirect="{{ editUrl }}" class="flex flex-col gap-4">
                <input type="hidden" name="activityCollectionId" value="{{ activityCollection.getId() }}">
                <div data-form-error class="form-error hidden" role="alert"></div>
                <div>
                    <label for="activity-collection-activity">{{ "Activity"|trans({}, 'admin') }}</label>
                    <input type="text" id="activity-collection-activity" name="activityId"
                           placeholder="{{ "Search by name, date or activity ID"|trans({}, 'admin') }}"
                           autocomplete="off" spellcheck="false"
                           data-autocomplete-url="{{ relativeUrl(path('admin_activity_search')) }}"
                           data-autocomplete-use-reference
                           required>
                </div>
                <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                    <a href="{{ editUrl }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
                    <button type="submit" data-has-loading-state class="group btn--primary">
                        <span class="label">{{ "Add"|trans({}, 'admin') }}</span>
                        <span class="label--loading">{{ "Adding..."|trans({}, 'admin') }}</span>
                    </button>
                </div>
            </form>
        {% endblock %}
    {% endembed %}
{% endblock main %}
