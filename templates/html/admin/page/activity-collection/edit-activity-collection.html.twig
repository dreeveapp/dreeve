{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set activityCollection = activityCollection is defined ? activityCollection : null %}
    {% set activityCollectionId = activityCollection ? activityCollection.getId() : activityCollectionId %}
    {% set overviewUrl = redirectUrl(relativeUrl(path('admin_manage_activity_collection_overview'))) %}
    {% embed 'html/admin/component/modal.html.twig' with {closeUrl: overviewUrl, modalSize: 'max-w-2xl'} %}
        {% block title %}{{ activityCollection ? "Edit collection"|trans({}, 'admin') : "Add collection"|trans({}, 'admin') }}{% endblock %}
        {% block body %}
            <form data-dispatch-command="{{ dispatchCommand }}" data-redirect="{{ activityCollection ? overviewUrl : relativeUrl(path('admin_edit_activity_collection', {activityCollectionId: activityCollectionId})) }}" class="flex flex-col gap-4">
                <input type="hidden" name="activityCollectionId" value="{{ activityCollectionId }}">
                <div data-form-error class="form-error hidden" role="alert"></div>
                <div>
                    <label for="activity-collection-name">{{ "Name"|trans }}</label>
                    <input type="text" id="activity-collection-name" name="name" required value="{{ activityCollection ? activityCollection.getName() }}">
                </div>
                <div>
                    {% set currentType = activityCollection ? activityCollection.getType() : null %}
                    <label for="activity-collection-type">{{ "Type"|trans({}, 'admin') }}</label>
                    <select id="activity-collection-type" name="type">
                        {% for type in types %}
                            <option value="{{ type.value }}" {{ type == currentType ? 'selected' }}>{{ type|trans }}</option>
                        {% endfor %}
                    </select>
                    <p class="description">{{ "The type decides how the collection page is laid out."|trans({}, 'admin') }}</p>
                </div>
                <div>
                    <label for="activity-collection-description">{{ "Description"|trans({}, 'admin') }}</label>
                    <textarea id="activity-collection-description" name="description" rows="3">{{ activityCollection ? activityCollection.getDescription() }}</textarea>
                </div>
                <div>
                    <label>{{ "Cover image"|trans({}, 'admin') }}</label>
                    {% set existingImages = [] %}
                    {% if activityCollection and activityCollection.getCoverImagePath() %}
                        {% set path = activityCollection.getCoverImagePath() %}
                        {% set existingImages = [{ url: path, name: path|split('/')|last, path: path }] %}
                    {% endif %}
                    {% include 'html/admin/component/image-dropzone-upload.html.twig' with { name: 'coverImagePath', maxImages: 1, existingImages: existingImages } %}
                    <p class="description">{{ "Without a cover image, the first photo of the collection's activities is used."|trans({}, 'admin') }}</p>
                </div>
                {% if activityCollection %}
                    {% set editUrl = relativeUrlWithRedirectTo(path('admin_edit_activity_collection', {activityCollectionId: activityCollectionId}), overviewUrl) %}
                    <div class="flex flex-col gap-2">
                        <span class="text-sm font-medium text-gray-700">{{ "Activities"|trans }}</span>
                        <div class="relative max-h-96 overflow-auto">
                            <table class="data-table">
                                <thead>
                                <tr>
                                    <th scope="col" class="narrow">
                                        <span class="sr-only">{{ "In collection"|trans({}, 'admin') }}</span>
                                    </th>
                                    <th scope="col" class="text-left">
                                        {{ "Name"|trans }}
                                    </th>
                                    <th scope="col" class="text-left">
                                        {{ "Sport type"|trans({}, 'admin') }}
                                    </th>
                                    <th scope="col" class="text-left">
                                        {{ "Date"|trans }}
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for activity in activities %}
                                    <tr class="group/member has-[input:not(:checked)]:bg-red-50/60!">
                                        <td class="narrow">
                                            <input type="checkbox" name="activityIds[]" value="{{ activity.getId() }}" checked aria-label="{{ activity.getName() }}">
                                        </td>
                                        <td class="whitespace-nowrap text-left">
                                            <a class="block max-w-100 truncate font-medium text-blue-600 hover:underline group-has-[input:not(:checked)]/member:line-through"
                                               title="{{ activity.getName() }}"
                                               href="{{ relativeUrl(path('activity', {'activityId': activity.getId()})) }}">
                                                {{ activity.getName() }}
                                            </a>
                                        </td>
                                        <td class="whitespace-nowrap text-left">
                                            {{ activity.getSportType()|transSingular }}
                                        </td>
                                        <td class="whitespace-nowrap text-left">
                                            {{ activity.getStartDate()|formatDate() }}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-gray-500">
                                            {{ "No activities added yet."|trans({}, 'admin') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <p class="description">{{ "Unchecked activities are removed from the collection when you save."|trans({}, 'admin') }}</p>
                    </div>
                    <div class="group/add-activities">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-sm font-medium text-gray-700">{{ "Add activities"|trans({}, 'admin') }}</span>
                            <div role="group" aria-label="{{ "Add activities"|trans({}, 'admin') }}" class="shrink-0 inline-flex items-center bg-gray-100 rounded-lg p-0.5 text-xxs font-medium">
                                <input type="radio" name="addActivitiesBy" id="add-activities-by-activity" value="activity" class="sr-only peer/activity" checked>
                                <label for="add-activities-by-activity" class="cursor-pointer rounded-md px-2 py-1 text-xxs text-gray-500 transition peer-checked/activity:bg-white peer-checked/activity:text-gray-900 peer-checked/activity:shadow-xs peer-focus-visible/activity:ring-2 peer-focus-visible/activity:ring-primary/40">{{ "Activity"|trans({}, 'admin') }}</label>
                                <input type="radio" name="addActivitiesBy" id="add-activities-by-date-range" value="dateRange" class="sr-only peer/date-range">
                                <label for="add-activities-by-date-range" class="cursor-pointer rounded-md px-2 py-1 text-xxs text-gray-500 transition peer-checked/date-range:bg-white peer-checked/date-range:text-gray-900 peer-checked/date-range:shadow-xs peer-focus-visible/date-range:ring-2 peer-focus-visible/date-range:ring-primary/40">{{ "Date range"|trans({}, 'admin') }}</label>
                            </div>
                        </div>
                        <div class="flex gap-2 group/add-activity group-has-[#add-activities-by-date-range:checked]/add-activities:hidden">
                            <input type="text" name="activityIdToAdd" aria-label="{{ "Add activity"|trans({}, 'admin') }}"
                                   placeholder="{{ "Search by name, date or activity ID"|trans({}, 'admin') }}"
                                   autocomplete="off" spellcheck="false"
                                   data-autocomplete-url="{{ relativeUrl(path('admin_activity_search')) }}"
                                   data-autocomplete-use-reference>
                            <button type="submit" data-has-loading-state class="group btn--secondary shrink-0 group-has-[input:placeholder-shown]/add-activity:hidden"
                                    data-redirect="{{ editUrl }}">
                                {{ svg('plus') }}
                                <span class="label">{{ "Add"|trans({}, 'admin') }}</span>
                                <span class="label--loading">{{ "Adding..."|trans({}, 'admin') }}</span>
                            </button>
                        </div>
                        <div class="hidden gap-2 group-has-[#add-activities-by-date-range:checked]/add-activities:flex">
                            <div class="grid grow grid-cols-2 gap-3">
                                <input type="date" name="addActivitiesFrom" aria-label="{{ "From"|trans({}, 'admin') }}">
                                <input type="date" name="addActivitiesTill" aria-label="{{ "To"|trans({}, 'admin') }}">
                            </div>
                            <button type="submit" data-has-loading-state class="group btn--secondary shrink-0"
                                    data-redirect="{{ editUrl }}">
                                {{ svg('plus') }}
                                <span class="label">{{ "Add"|trans({}, 'admin') }}</span>
                                <span class="label--loading">{{ "Adding..."|trans({}, 'admin') }}</span>
                            </button>
                        </div>
                    </div>
                {% endif %}
                <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                    {% if activityCollection %}
                        <a href="{{ relativeUrl(path('admin_delete_activity_collection', {activityCollectionId: activityCollectionId})) }}" type="button" class="btn--danger me-auto">{{ "Delete"|trans({}, 'admin') }}</a>
                    {% endif %}
                    <a href="{{ overviewUrl }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
                    <button type="submit" data-has-loading-state class="group btn--primary">
                        <span class="label">{{ activityCollection ? "Save"|trans({}, 'admin') : "Save and add activities"|trans({}, 'admin') }}</span>
                        <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                    </button>
                </div>
            </form>
        {% endblock %}
    {% endembed %}
{% endblock main %}
