{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% embed 'html/admin/component/delete-confirm-modal.html.twig' with {closeUrl: relativeUrl(path('admin_manage_gear_maintenance_config'))} %}
        {% block title %}{{ "Delete component"|trans({}, 'admin') }}{% endblock %}
        {% block hidden_fields %}
            <input type="hidden" name="gearComponentId" value="{{ component.getId() }}">
        {% endblock %}
        {% block message %}
            {% autoescape false %}
            <p>
                {{ "Are you sure you want to delete the {component} component?"|trans({
                    '{component}': '<span class="font-semibold text-gray-900">' ~ component.getLabel() ~ '</span>',
                }, 'admin') }}
            </p>
            <p>
                {{ "All associated maintenance tasks and logs will be removed. This action cannot be undone."|trans({}, 'admin') }}
            </p>
            {% endautoescape %}
        {% endblock %}
    {% endembed %}
{% endblock main %}
