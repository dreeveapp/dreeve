{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set gear = gear is defined ? gear : null %}
    {% set isReadOnly = gear ? gear.getType().isImported() : false %}
    {% embed 'html/admin/component/modal.html.twig' with {closeUrl: relativeUrl(path('admin_manage_gear_overview'))} %}
        {% block title %}{{ gear ? "Edit gear"|trans({}, 'admin') : "Add gear"|trans({}, 'admin') }}{% endblock %}
        {% block body %}
            {% autoescape false %}
            <form data-dispatch-command="{{ dispatchCommand }}" data-redirect="{{ relativeUrl(path('admin_manage_gear_overview')) }}" class="flex flex-col gap-4">
            {% if gear %}
                <input type="hidden" name="gearId" value="{{ gear.getId() }}">
            {% endif %}
            <div data-form-error class="form-error hidden" role="alert"></div>
            {% embed 'html/admin/component/strava-disabled-form-input.html.twig' with {
                isReadOnly: isReadOnly, label: 'Name'|trans,
                for: 'gear-name', name: 'name', value: gear ? gear.getOriginalName(),
            } %}
                {% block control %}
                    <input type="text" id="gear-name" name="name" required value="{{ gear ? gear.getOriginalName() }}" {{ disabled ? 'disabled' }}>
                {% endblock %}
            {% endembed %}
            <div>
                <label for="gear-purchase-price">{{ "Purchase price"|trans }}</label>
                {% set purchasePrice = gear ? gear.getPurchasePrice() : null %}
                {% set purchasePriceCurrency = purchasePrice ? purchasePrice.getCurrency().getCode() : 'EUR' %}
                <div class="mt-1 flex gap-2">
                    <input type="number" step="0.01" min="0" id="gear-purchase-price" name="purchasePriceAmount" value="{{ purchasePrice|formatMoneyDecimal }}" placeholder="0.00">
                    <select name="purchasePriceCurrency" class="w-auto">
                        {% for currency in currencies() %}
                            <option value="{{ currency }}" {{ currency == purchasePriceCurrency ? 'selected' }}>{{ currency }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            {% set currentStatus = gear ? gear.getStatus() : null %}
            {% embed 'html/admin/component/strava-disabled-form-input.html.twig' with {
                isReadOnly: isReadOnly, label: 'Status'|trans,
                for: 'gear-status', name: 'status', value: currentStatus ? currentStatus.value,
            } %}
                {% block control %}
                    <select id="gear-status" name="status" {{ disabled ? 'disabled' }}>
                        {% for status in statuses %}
                            <option value="{{ status.value }}" {{ status == currentStatus ? 'selected' }}>{{ status|trans }}</option>
                        {% endfor %}
                    </select>
                {% endblock %}
            {% endembed %}
            <div>
                <label>{{ "Image"|trans({}, 'admin') }}</label>
                {% set existingImages = [] %}
                {% if gear and gear.getLocalImagePath() %}
                    {% set path = gear.getLocalImagePath() %}
                    {% set existingImages = [{ url: path, name: path|split('/')|last, path: path }] %}
                {% endif %}
                {% include 'html/admin/component/image-dropzone-upload.html.twig' with { name: 'localImagePath', maxImages: 1, existingImages: existingImages } %}
            </div>
            <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                {% if isDeletable %}
                    <a href="{{ relativeUrl(path('admin_delete_gear', {gearId: gear.getId()})) }}" type="button" class="btn--danger me-auto">{{ "Delete"|trans({}, 'admin') }}</a>
                {% endif %}
                <a href="{{ relativeUrl(path('admin_manage_gear_overview')) }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
                <button type="submit" data-has-loading-state class="group btn--primary">
                    <span class="label">{{ "Save"|trans({}, 'admin') }}</span>
                    <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                </button>
            </div>
        </form>
            {% endautoescape %}
        {% endblock %}
    {% endembed %}
{% endblock main %}
