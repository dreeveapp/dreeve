{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set isBulk = activities|length > 1 %}
    {% embed 'html/admin/component/delete-confirm-modal.html.twig' with {closeUrl: redirectUrl(relativeUrl(path('admin_manage_activity_overview')))} %}
        {% block title %}
            {% if isBulk %}
                {{ "Delete activities"|trans({}, 'admin') }}
            {% else %}
                {{ "Delete activity"|trans({}, 'admin') }}
            {% endif %}
        {% endblock %}
        {% block hidden_fields %}
            {% for activity in activities %}
                <input type="hidden" name="activityIds[]" value="{{ activity.getId() }}">
            {% endfor %}
        {% endblock %}
        {% block message %}
            {% autoescape false %}
            <p>
                {% if isBulk %}
                    {{ "Are you sure you want to delete {count} activities?"|trans({
                        '{count}': '<span class="font-semibold text-gray-900">' ~ activities|length ~ '</span>',
                    }, 'admin') }}
                {% else %}
                    {{ "Are you sure you want to delete {name}?"|trans({
                        '{name}': '<span class="font-semibold text-gray-900">' ~ (activities|first).getName() ~ '</span>',
                    }, 'admin') }}
                {% endif %}
            </p>
            <p>
                {{ "This action cannot be undone."|trans({}, 'admin') }}
            </p>
            {% endautoescape %}
        {% endblock %}
        {% block after_message %}
            {% if isBulk %}
                <ul data-activities-to-delete class="max-h-64 overflow-y-auto rounded-lg border border-gray-200 divide-y divide-gray-200 text-sm">
                    {% for activity in activities %}
                        <li class="flex items-center gap-2 px-3 py-2">
                            <span class="min-w-0 truncate font-medium text-gray-800">{{ activity.getName() }}</span>
                            <span class="ms-auto shrink-0 text-xs text-gray-500">{{ activity.getStartDate()|formatDate() }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock main %}
