{% extends "html/admin/page/template.html.twig" %}
{% block stylesheets %}
    <link href="{{ relativeUrl(asset('libraries/leaflet/leaflet.min.css')) }}" rel="stylesheet"/>
{% endblock %}
{% block main %}
    {% set returnUrl = redirectUrl(relativeUrl(path('admin_edit_activity', {activityId: activity.getId()}))) %}
    {% set coordinate = mediaItem.getCoordinate() %}
    {% set coordinatePickerOptions = activity.getLeafletMap() ? {
        polylineUrl: relativeUrl(path('activity_polylines', {activityId: activity.getId()})),
        maxDistanceFromRouteInMeter: constant('App\\Domain\\Media\\MediaItem::MAX_DISTANCE_FROM_ROUTE_IN_METER'),
    } : {} %}
    {% embed 'html/admin/component/modal.html.twig' with {closeUrl: returnUrl, modalSize: 'max-w-3xl'} %}
        {% block title %}{{ "Edit media"|trans({}, 'admin') }}{% endblock %}
        {% block body %}
            {% autoescape false %}
            <form data-dispatch-command="{{ dispatchCommand }}" data-redirect="{{ returnUrl }}" class="flex flex-col gap-4">
                <input type="hidden" name="mediaItemId" value="{{ mediaItem.getId() }}">
                <div data-form-error class="form-error hidden" role="alert"></div>
                <div data-coordinate-picker='{{ coordinatePickerOptions|json_encode }}' class="flex flex-col gap-4">
                    <div class="flex flex-col gap-4 sm:flex-row">
                        <img class="mx-auto h-auto max-h-64 w-auto max-w-full shrink-0 self-start rounded-lg border border-gray-200 bg-gray-100 sm:max-w-sm"
                             src="{{ relativeUrl(mediaItem.getPath().toUrlPath()) }}" alt="{{ mediaItem.getPath().getFilename() }}">
                        <div class="flex min-w-0 flex-1 flex-col gap-4">
                            <div>
                                <label for="media-item-taken-on">{{ "Taken on"|trans({}, 'admin') }}</label>
                                <input type="datetime-local" step="1" id="media-item-taken-on" name="takenOn"
                                       value="{{ mediaItem.getTakenOn() ? mediaItem.getTakenOn().format('Y-m-d\\TH:i:s') }}">
                            </div>
                            <div>
                                <label for="media-item-latitude">{{ "Latitude"|trans({}, 'admin') }}</label>
                                <input type="number" step="any" min="-90" max="90" id="media-item-latitude" name="latitude"
                                       data-coordinate-picker-field="latitude" placeholder="51.0543"
                                       value="{{ coordinate ? coordinate.getLatitude().toFloat() }}">
                            </div>
                            <div>
                                <label for="media-item-longitude">{{ "Longitude"|trans({}, 'admin') }}</label>
                                <input type="number" step="any" min="-180" max="180" id="media-item-longitude" name="longitude"
                                       data-coordinate-picker-field="longitude" placeholder="3.7174"
                                       value="{{ coordinate ? coordinate.getLongitude().toFloat() }}">
                            </div>
                        </div>
                    </div>
                    <div>
                        <p class="mb-1 text-xxs text-gray-500">{{ "Click the map to set the location, or drag the marker to fine-tune it."|trans({}, 'admin') }}</p>
                        <div data-coordinate-picker-map class="h-64 w-full rounded-lg border border-gray-200 bg-gray-100"></div>
                    </div>
                    {% if coordinatePickerOptions %}
                        <div class="flex flex-wrap gap-2">
                            <button type="button" data-has-loading-state class="group btn--small"
                                    data-fill-fields="{{ relativeUrl(path('admin_locate_activity_media_item_by_time', {activityId: activity.getId(), mediaItemId: mediaItem.getId()})) }}">
                                <span class="label">{{ "Locate by time"|trans({}, 'admin') }}</span>
                                <span class="label--loading">{{ "Locating..."|trans({}, 'admin') }}</span>
                            </button>
                            {% if isAIMediaLocationSuggestionEnabled() %}
                                <button type="button" data-has-loading-state class="group btn--small"
                                        data-fill-fields="{{ relativeUrl(path('admin_suggest_activity_media_item_location', {activityId: activity.getId(), mediaItemId: mediaItem.getId()})) }}">
                                    <span class="label">{{ "Suggest with AI"|trans({}, 'admin') }}</span>
                                    <span class="label--loading">{{ "Suggesting..."|trans({}, 'admin') }}</span>
                                </button>
                            {% endif %}
                        </div>
                        {% if isAIMediaLocationSuggestionEnabled() %}
                            <div data-fill-fields-message class="alert alert--info hidden" role="status"></div>
                        {% endif %}
                        <div data-coordinate-picker-warning class="alert alert--warning hidden" role="alert">
                            <span class="sr-only">{{ "Warning"|trans({}, 'admin') }}</span>
                            <div>{{ "This location is far from the route, so the photo will not show on the activity map."|trans({}, 'admin') }}</div>
                        </div>
                    {% endif %}
                </div>
                <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                    <a href="{{ returnUrl }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
                    <button type="submit" data-has-loading-state class="group btn--primary">
                        <span class="label">{{ "Save"|trans({}, 'admin') }}</span>
                        <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                    </button>
                </div>
            </form>
            {% endautoescape %}
        {% endblock %}
    {% endembed %}
{% endblock main %}
