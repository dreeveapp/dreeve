{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    <div class="py-8 px-4 mx-auto max-w-(--breakpoint-xl) lg:py-16 lg:px-6">
        <div class="mx-auto max-w-(--breakpoint-sm) text-center">
            <h1 class="mb-4 text-7xl tracking-tight font-extrabold lg:text-9xl text-gray-900">404</h1>
            <p class="mb-4 text-3xl tracking-tight font-bold text-gray-900 md:text-4xl">
                {{ "Oops, looks like you've wandered off the map! 🗺️"|trans({}, 'admin') }}
            </p>
            <p class="mb-4 text-lg font-light text-gray-500">
                {{ "The page you're looking for doesn't exist or may have been moved."|trans({}, 'admin') }}
            </p>
            <a href="{{ relativeUrl(path('admin')) }}"
               class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:opacity-90 transition">
                {{ "Back to the admin panel"|trans({}, 'admin') }}
            </a>
        </div>
    </div>
{% endblock main %}
