{% autoescape false %}
<form data-dispatch-command="{{ queueCommand }}"
      data-redirect="{{ relativeUrl(path('admin_manage_automation_rules_overview')) }}">
    {% for automationRuleId in selectedAutomationRuleIds %}
        <input type="hidden" name="automationRuleIds[]" value="{{ automationRuleId }}">
    {% endfor %}

    <div class="alert alert--warning mb-4" role="alert">
        {{ "The backfill runs on the next import cycle, using the rules as they are configured at that moment. This cannot be undone."|trans({}, 'admin') }}
    </div>

    <div class="flex flex-wrap gap-3">
        <div class="flex-1 min-w-40 rounded-lg border border-gray-200 bg-gray-50 p-3">
            <span class="block text-2xl font-semibold text-gray-900">{{ totalMatched }}</span>
            <span class="text-xs text-gray-500">{{ "Matching activities"|trans({}, 'admin') }}</span>
        </div>
        <div class="flex-1 min-w-40 rounded-lg border border-gray-200 bg-gray-50 p-3">
            <span class="block text-2xl font-semibold text-gray-900">{{ totalScanned }}</span>
            <span class="text-xs text-gray-500">{{ "Activities scanned"|trans({}, 'admin') }}</span>
        </div>
    </div>

    {% if matchedActivities is not empty %}
        <div class="mt-4">
            <h4 class="text-sm font-semibold text-gray-800">{{ "Activities to update"|trans({}, 'admin') }}</h4>
            <div class="mt-2 max-h-128 overflow-y-auto rounded-lg border border-gray-200 divide-y divide-gray-200"
                 data-required-checkbox-group="{{ "Select at least one activity."|trans({}, 'admin') }}">
                {% for matchedActivity in matchedActivities %}
                    <label class="flex items-start gap-3 bg-white p-3 cursor-pointer hover:bg-gray-50">
                        <input type="checkbox" class="mt-1 shrink-0" name="activityIds[]" value="{{ matchedActivity.id }}" checked>
                        <span class="min-w-0 flex-1">
                            <span class="flex items-center gap-2">
                                <span class="font-medium text-gray-800 truncate">{{ matchedActivity.name }}</span>
                                <span class="ms-auto text-xs text-gray-500 shrink-0">{{ matchedActivity.startDate }}</span>
                            </span>
                            <span class="mt-1 flex flex-wrap gap-1">
                                {% for ruleLabel in matchedActivity.ruleLabels %}
                                    <span class="pill pill--neutral">{{ ruleLabel }}</span>
                                {% endfor %}
                            </span>
                        </span>
                    </label>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="mt-4 flex flex-col gap-2 border-t border-gray-200 pt-4">
        <div class="flex justify-end gap-2">
            <a href="{{ relativeUrl(path('admin_manage_automation_rules_overview')) }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
            <button type="submit" data-has-loading-state class="group btn--add" {{ totalMatched == 0 ? 'disabled' : '' }}>
                <span class="label">{{ "Apply to existing activities"|trans({}, 'admin') }}</span>
                <span class="label--loading">{{ "Queueing..."|trans({}, 'admin') }}</span>
            </button>
        </div>
        <span class="text-xs text-red-600" data-form-error></span>
    </div>
</form>
{% endautoescape %}
