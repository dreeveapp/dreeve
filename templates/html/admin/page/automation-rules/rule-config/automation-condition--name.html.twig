<div class="grid gap-2 sm:grid-cols-2">
    <div>
        <label class="mt-0! text-xs">{{ "Operator"|trans({}, 'admin') }}</label>
        <select name="{{ namePrefix }}[operator]" data-repeater-field="config.operator" class="mt-0">
            {% for operator in enum('App\\Domain\\Automation\\Condition\\MatchOperator').cases()|filter(o => o.isForText()) %}
                <option value="{{ operator.value }}">{{ operator|trans }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label class="mt-0! text-xs">{{ "Activity name"|trans({}, 'admin') }}</label>
        <input type="text" name="{{ namePrefix }}[value]" data-repeater-field="config.value" required
               placeholder="{{ "eg: commute"|trans({}, 'admin') }}" class="mt-0">
    </div>
</div>
