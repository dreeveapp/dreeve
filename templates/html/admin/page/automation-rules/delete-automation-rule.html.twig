{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% embed 'html/admin/component/delete-confirm-modal.html.twig' with {closeUrl: relativeUrl(path('admin_manage_automation_rules_overview'))} %}
        {% block title %}{{ "Delete automation rule"|trans({}, 'admin') }}{% endblock %}
        {% block hidden_fields %}
            <input type="hidden" name="automationRuleId" value="{{ automationRule.getId() }}">
        {% endblock %}
        {% block message %}
            {% autoescape false %}
            <p>
                {{ "Are you sure you want to delete the {rule} rule?"|trans({
                    '{rule}': '<span class="font-semibold text-gray-900">' ~ automationRule.getLabel() ~ '</span>',
                }, 'admin') }}
            </p>
            <p>
                {{ "Deleting a rule does not revert changes it already made to activities. This action cannot be undone."|trans({}, 'admin') }}
            </p>
            {% endautoescape %}
        {% endblock %}
    {% endembed %}
{% endblock main %}
