{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% embed 'html/admin/component/delete-confirm-modal.html.twig' with {closeUrl: relativeUrl(path('admin_settings_dashboard'))} %}
        {% block title %}{{ "Remove widget"|trans({}, 'admin') }}{% endblock %}
        {% block hidden_fields %}
            <input type="hidden" name="dashboardWidgetId" value="{{ widget.getId() }}">
        {% endblock %}
        {% block message %}
            {% autoescape false %}
            <p>
                {{ "Are you sure you want to remove the {widget} widget?"|trans({
                    '{widget}': '<span class="font-semibold text-gray-900">' ~ widget.getAdminLabel()|e ~ '</span>',
                }, 'admin') }}
            </p>
            <p>
                {{ "You can add it back to your dashboard again later."|trans({}, 'admin') }}
            </p>
            {% endautoescape %}
        {% endblock %}
        {% block submit_label %}{{ "Remove"|trans({}, 'admin') }}{% endblock %}
        {% block submit_loading_label %}{{ "Removing..."|trans({}, 'admin') }}{% endblock %}
    {% endembed %}
{% endblock main %}
