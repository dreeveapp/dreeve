{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set dashboardUrl = relativeUrl(path('admin_settings_dashboard')) %}
    {% embed 'html/admin/component/modal.html.twig' with {closeUrl: dashboardUrl, modalSize: configuredWidget.hasWideConfigurationForm() ? 'max-w-3xl' : 'max-w-lg'} %}
        {% block title %}{% autoescape false %}{{ "Configure {widget}"|trans({'{widget}': configuredWidget.getAdminLabel()}, 'admin') }}{% endautoescape %}{% endblock %}
        {% block body %}
            {% autoescape false %}
            <form data-dispatch-command="{{ dispatchCommand }}" data-redirect="{{ dashboardUrl }}" class="flex flex-col gap-4">
                <input type="hidden" name="dashboardWidgetId" value="{{ configuredWidget.getId() }}">
                <div data-form-error class="form-error hidden" role="alert"></div>

                {% if configuredWidget.hasConfigurableTitle() %}
                    <div>
                        <label for="config-title">{{ "Title"|trans({}, 'admin') }}</label>
                        <input type="text" id="config-title" name="config[title]" maxlength="{{ constant('App\\Domain\\Dashboard\\Widget\\WidgetConfiguration::MAX_TITLE_LENGTH') }}" value="{{ configuredWidget.getConfiguration().getTitle()|e }}" placeholder="{{ configuredWidget.getWidget().getLabel()|e }}">
                        <p class="mt-1 text-xxs text-gray-500">{{ "Leave empty to use the default title."|trans({}, 'admin') }}</p>
                    </div>
                {% endif %}

                {% set configurationTemplate = configuredWidget.getConfigurationTemplate() %}
                {% if configurationTemplate %}
                    {% include configurationTemplate with { configuration: configuredWidget.getConfiguration() } only %}
                {% endif %}

                <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                    <a href="{{ dashboardUrl }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
                    <button type="submit" data-has-loading-state class="group btn--primary">
                        <span class="label">{{ "Save"|trans({}, 'admin') }}</span>
                        <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                    </button>
                </div>
            </form>
            {% endautoescape %}
        {% endblock %}
    {% endembed %}
{% endblock main %}
