{% extends "html/admin/page/settings/template.html.twig" %}
{% set settingsTitle = "Weight history"|trans %}

{% block sections %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Garmin Connect"|trans({}, 'admin'),
        description: "Sync your weight with Garmin Connect on the same schedule as your activities. Manual entries remain available and take priority for the same date."|trans({}, 'admin'),
    } %}
        {% block body %}
            <label class="flex items-center gap-2 mt-0! font-medium cursor-pointer">
                <input type="hidden" name="data[garminWeightSyncEnabled]" value="0">
                <input type="checkbox" name="data[garminWeightSyncEnabled]" value="1"
                       {{ (settings.garminWeightSyncEnabled ?? false) ? 'checked' : '' }}>
                <span>{{ "Sync weight from Garmin Connect"|trans({}, 'admin') }}</span>
            </label>
            <p class="description">{{ "Requires the Garmin connector to be connected to this Dreeve instance. Turning sync off keeps previously imported weigh-ins."|trans({}, 'admin') }}</p>
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Weigh-ins"|trans({}, 'admin'),
        description: "History of weight (in kg or pounds, depending on the appearance unit system). Needed to calculate relative w/kg."|trans({}, 'admin'),
    } %}
        {% block body %}
            <p class="description mb-2">{{ "Garmin entries are read-only. Add a manual entry to override an imported weight for the same date."|trans({}, 'admin') }}</p>
            {% include 'html/admin/page/settings/component/weight-history-editor.html.twig' with {rows: weightHistoryRows} %}
        {% endblock %}
    {% endembed %}
{% endblock sections %}
