{% extends "html/admin/page/settings/template.html.twig" %}
{% set settingsTitle = "Weight history"|trans %}

{% block sections %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Weigh-ins"|trans({}, 'admin'),
        description: "History of weight (in kg or pounds, depending on the appearance unit system). Needed to calculate relative w/kg."|trans({}, 'admin'),
    } %}
        {% block body %}
            {% import 'html/admin/page/settings/macro/history-editor.html.twig' as editor %}
            {{ editor.historyEditor(
                'data[weightHistory]',
                settings.weightHistory ?? [],
                null,
                null,
                "Weight"|trans,
                "Add weight"|trans({}, 'admin'),
                'weight',
                'any'
            ) }}
        {% endblock %}
    {% endembed %}
{% endblock sections %}
