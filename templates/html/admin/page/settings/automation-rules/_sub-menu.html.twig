{% autoescape false %}
<ul class="tabs tabs--menu-item">
    <li>
        <a href="{{ relativeUrl(path('admin_manage_automation_rules_overview')) }}" class="{{ activeMenuItem == 'rules' ? 'active' : '' }}">
            {{ "Rules"|trans({}, 'admin') }}
        </a>
    </li>
    {% if hasEnabledRules|default(false) %}
        <li>
            <a href="{{ relativeUrl(path('admin_test_automation_rules')) }}" class="{{ activeMenuItem == 'test' ? 'active' : '' }}">
                {{ "Test rules"|trans({}, 'admin') }}
            </a>
        </li>
    {% endif %}
    {% if hasEnabledRules|default(false) %}
        <li>
            <a href="{{ relativeUrl(path('admin_backfill_automation_rules')) }}" class="{{ activeMenuItem == 'backfill' ? 'active' : '' }}">
                {{ "Apply to existing activities"|trans({}, 'admin') }}
            </a>
        </li>
    {% endif %}
</ul>
{% endautoescape %}
