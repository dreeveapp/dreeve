{% extends "html/admin/page/template.html.twig" %}

{% block main %}
    <div class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold">{{ settingsTitle }}</h2>
        <form data-dispatch-command="{{ dispatchCommand }}"{% if formRedirect is defined %} data-redirect="{{ formRedirect }}"{% endif %} class="flex flex-col gap-4">
            <input type="hidden" name="group" value="{{ group.value }}">
            <div data-form-error class="form-error hidden" role="alert"></div>
            {% block sections %}{% endblock %}
            <div class="flex justify-end">
                <button type="submit" data-has-loading-state class="group btn--primary">
                    <span class="label">{{ "Save settings"|trans({}, 'admin') }}</span>
                    <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                </button>
            </div>
        </form>
        {% block afterForm %}{% endblock %}
    </div>
{% endblock main %}
