{% extends "html/admin/page/template.html.twig" %}

{% block main %}
    <div class="flex flex-col gap-4">
        <form data-dispatch-command="{{ dispatchCommand }}" class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <input type="hidden" name="group" value="{{ group.value }}">
            <div class="mb-5">
                <h3 class="text-lg font-semibold">{{ "Security"|trans({}, 'admin') }}</h3>
            </div>
            <div data-form-error class="form-error hidden" role="alert"></div>
            <div class="flex flex-col gap-4">
                <div>
                    <label for="adminUsername">{{ "Admin username"|trans({}, 'admin') }}</label>
                    <input type="text" id="adminUsername" value="{{ adminUsername }}" disabled>
                    <p class="description">
                        {{ "Configured via an environment variable and cannot be changed here."|trans({}, 'admin') }}
                    </p>
                </div>
                <div>
                    <label for="adminAllowedIpAddresses">{{ "Allowed IP addresses for the admin panel"|trans({}, 'admin') }}</label>
                    <input type="text" id="adminAllowedIpAddresses" value="{{ adminAllowedIpAddresses }}"
                           placeholder="{{ "Any IP address"|trans({}, 'admin') }}" disabled>
                    <p class="description">
                        {{ "When set, requests to the admin panel from any other IP address are rejected."|trans({}, 'admin') }}
                        {{ "Configured via an environment variable and cannot be changed here."|trans({}, 'admin') }}
                        {% if clientIpAddress %}
                            <br>
                            {{ "Your current IP address, as seen by Dreeve, is {ipAddress}."|trans({'ipAddress': clientIpAddress}, 'admin') }}
                        {% endif %}
                    </p>
                </div>
                <div>
                    <label class="flex items-center gap-2 mt-0! font-medium cursor-pointer">
                        <input type="checkbox" name="data[requiresAuthentication]" value="1"
                               {{ (settings.requiresAuthentication ?? false) ? 'checked' : '' }}>
                        <span>{{ "Require a login for the entire app"|trans({}, 'admin') }}</span>
                    </label>
                    <p class="description">
                        {{ "Require a login for the entire app, not just the admin panel. Recommended when your instance is reachable from the internet, which it has to be for the Strava webhook."|trans({}, 'admin') }}
                    </p>
                </div>
            </div>
            <div class="flex justify-end gap-2 border-t border-gray-200 pt-4 mt-6">
                <button type="submit" data-has-loading-state class="group btn--primary">
                    <span class="label">{{ "Save settings"|trans({}, 'admin') }}</span>
                    <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                </button>
            </div>
        </form>
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <div class="mb-5">
                <h3 class="text-lg font-semibold">{{ "API access"|trans({}, 'admin') }}</h3>
            </div>
            <div class="flex flex-col gap-4">
                <p class="description mt-0!">
                    {{ "Lets an external client upload activity files over HTTP. The key is the only thing guarding that endpoint, so treat it like a password."|trans({}, 'admin') }}
                    {{ "The allowed IP addresses above do not apply to it, the key is the only access control there."|trans({}, 'admin') }}
                </p>
                {% if not apiKey.isEmpty() and not apiKey.hasValidFormat() %}
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-red-50 text-sm text-red-800" role="alert">
                        <svg class="size-5 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.6 3.5a1.6 1.6 0 0 1 2.8 0l7.7 13.8a1.6 1.6 0 0 1-1.4 2.4H4.3a1.6 1.6 0 0 1-1.4-2.4l7.7-13.8Z"/>
                        </svg>
                        <span>
                            {{ "{envVar} is set, but it is not a key this app generated, so the API stays closed. Generate a new one and replace it."|trans({'{envVar}': 'DREEVE_API_KEY'}, 'admin') }}
                        </span>
                    </div>
                {% endif %}
                <div>
                    <label for="apiKeyState" class="mt-0!">{{ "API key"|trans({}, 'admin') }}</label>
                    <input type="text" id="apiKeyState" disabled
                           value="{{ apiKey.isEmpty() ? "Not configured, the API is closed"|trans({}, 'admin') : "Configured"|trans({}, 'admin') }}">
                    <p class="description">
                        {{ "Set through the {envVar} environment variable and cannot be changed here."|trans({'{envVar}': 'DREEVE_API_KEY'}, 'admin') }}
                    </p>
                </div>
            </div>
            <div class="flex justify-end gap-2 border-t border-gray-200 pt-4 mt-6">
                <a href="{{ relativeUrl(path('admin_generate_api_key')) }}" type="button" class="btn--primary">
                    {{ "Generate an API key"|trans({}, 'admin') }}
                </a>
            </div>
        </div>
    </div>
{% endblock main %}
