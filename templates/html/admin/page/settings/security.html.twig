{% extends "html/admin/page/settings/template.html.twig" %}
{% set settingsTitle = "Security"|trans({}, 'admin') %}

{% block sections %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {title: "Access"|trans({}, 'admin')} %}
        {% block body %}
            <div>
                <label for="adminUsername">{{ "Admin username"|trans({}, 'admin') }}</label>
                <input type="text" id="adminUsername" value="{{ adminUsername }}" disabled>
                <p class="description">
                    {{ "Configured via an environment variable and cannot be changed here."|trans({}, 'admin') }}
                </p>
            </div>
            <div>
                <label for="adminAllowedIpAddresses">{{ "Allowed IP addresses for the admin panel"|trans({}, 'admin') }}</label>
                <input type="text" id="adminAllowedIpAddresses" value="{{ adminAllowedIpAddresses }}"
                       placeholder="{{ "Any IP address"|trans({}, 'admin') }}" disabled>
                <p class="description">
                    {{ "When set, requests to the admin panel from any other IP address are rejected."|trans({}, 'admin') }}
                    {{ "Configured via an environment variable and cannot be changed here."|trans({}, 'admin') }}
                    {% if clientIpAddress %}
                        <br>
                        {{ "Your current IP address, as seen by Dreeve, is {ipAddress}."|trans({'ipAddress': clientIpAddress}, 'admin') }}
                    {% endif %}
                </p>
            </div>
            <div>
                <label class="flex items-center gap-2 mt-0! font-medium cursor-pointer">
                    <input type="checkbox" name="data[requiresAuthentication]" value="1"
                           {{ (settings.requiresAuthentication ?? false) ? 'checked' : '' }}>
                    <span>{{ "Require a login for the entire app"|trans({}, 'admin') }}</span>
                </label>
                <p class="description">
                    {{ "Require a login for the entire app, not just the admin panel. Recommended when your instance is reachable from the internet, which it has to be for the Strava webhook."|trans({}, 'admin') }}
                </p>
            </div>
            <div>
                <label class="flex items-center gap-2 mt-0! font-medium cursor-pointer">
                    <input type="checkbox" name="data[visitorsCanDownloadOriginalFiles]" value="1"
                           {{ (settings.visitorsCanDownloadOriginalFiles ?? false) ? 'checked' : '' }}>
                    <span>{{ "Allow visitors to download original activity files"|trans({}, 'admin') }}</span>
                </label>
                <p class="description">
                    {{ "By default only you can download the original FIT, TCX or GPX file from an activity page. Original files can contain more detail than the page shows."|trans({}, 'admin') }}
                </p>
            </div>
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Single sign-on"|trans({}, 'admin') ~ ' (' ~ (oidcConfig.isEnabled() ? "Enabled"|trans({}, 'admin')|lower : "Disabled"|trans({}, 'admin'))|lower ~ ')',
        description: "Lets you log in to the admin panel through your own identity provider, next to the admin username and password."|trans({}, 'admin'),
    } %}
        {% block body %}
            {% if oidcConfig.isEnabled() %}
                <div>
                    <label for="oidcIssuerUrl" class="mt-0!">{{ "Issuer URL"|trans({}, 'admin') }}</label>
                    <input type="text" id="oidcIssuerUrl" value="{{ oidcConfig.getIssuerUrl() }}" disabled>
                    <p class="description">
                        {{ "Set through the {envVar} environment variable and cannot be changed here."|trans({'{envVar}': 'OIDC_ISSUER_URL'}, 'admin') }}
                    </p>
                </div>
                <div>
                    <label for="oidcClientId">{{ "Client ID"|trans({}, 'admin') }}</label>
                    <input type="text" id="oidcClientId" value="{{ oidcConfig.getClientId() }}" disabled>
                    <p class="description">
                        {{ "Set through the {envVar} environment variable and cannot be changed here."|trans({'{envVar}': 'OIDC_CLIENT_ID'}, 'admin') }}
                    </p>
                </div>
                <div>
                    <label for="oidcClientSecretState">{{ "Client secret"|trans({}, 'admin') }}</label>
                    <input type="text" id="oidcClientSecretState" value="{{ "Configured"|trans({}, 'admin') }}" disabled>
                    <p class="description">
                        {{ "Set through the {envVar} environment variable and cannot be changed here."|trans({'{envVar}': 'OIDC_CLIENT_SECRET'}, 'admin') }}
                    </p>
                </div>
                <div>
                    <label for="oidcAllowedUsers">{{ "Allowed users"|trans({}, 'admin') }}</label>
                    <input type="text" id="oidcAllowedUsers" value="{{ oidcConfig.getAllowedUsers()|join(', ') }}" disabled>
                    <p class="description">
                        {{ "Set through the {envVar} environment variable and cannot be changed here."|trans({'{envVar}': 'OIDC_ALLOWED_USERS'}, 'admin') }}
                    </p>
                </div>
                <div>
                    <label for="oidcRedirectUri">{{ "Redirect URI"|trans({}, 'admin') }}</label>
                    <input type="text" id="oidcRedirectUri" value="{{ oidcRedirectUri }}" readonly>
                    <p class="description">
                        {{ "Register this URL as the redirect URI with your identity provider."|trans({}, 'admin') }}
                    </p>
                </div>
            {% else %}
                {% set linkOpen = '<a class="font-semibold underline hover:no-underline" href="https://docs.dreeve.app/integrations/single-sign-on/">' %}
                {% set linkClose = '</a>' %}
                <p class="text-sm text-gray-500">
                    {{ "Detailed instructions are available in {linkOpen}the documentation{linkClose}."|trans({'{linkOpen}': linkOpen, '{linkClose}': linkClose}, 'admin')|raw }}
                </p>
            {% endif %}
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "API access"|trans({}, 'admin'),
        description: "Lets an external client access the API over HTTP. The key is the only thing guarding the API, so treat it like a password."|trans({}, 'admin') ~ ' ' ~ "The allowed IP addresses above do not apply to it, the key is the only access control there."|trans({}, 'admin'),
    } %}
        {% block body %}
            {% if not apiKey.isEmpty() and not apiKey.hasValidFormat() %}
                <div class="flex items-start gap-3 p-3 rounded-lg bg-red-50 text-sm text-red-800" role="alert">
                    <svg class="size-5 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.6 3.5a1.6 1.6 0 0 1 2.8 0l7.7 13.8a1.6 1.6 0 0 1-1.4 2.4H4.3a1.6 1.6 0 0 1-1.4-2.4l7.7-13.8Z"/>
                    </svg>
                    <span>
                        {{ "{envVar} is set, but it is not a key this app generated, so API access stays disabled. Generate a new one and replace it."|trans({'{envVar}': 'DREEVE_API_KEY'}, 'admin') }}
                    </span>
                </div>
            {% endif %}
            <div>
                <label for="apiKeyState" class="mt-0!">{{ "API key"|trans({}, 'admin') }}</label>
                <input type="text" id="apiKeyState" disabled
                       value="{{ apiKey.isEmpty() ? "Not configured, API access is disabled"|trans({}, 'admin') : "Configured"|trans({}, 'admin') }}">
                <p class="description">
                    {{ "Set through the {envVar} environment variable and cannot be changed here."|trans({'{envVar}': 'DREEVE_API_KEY'}, 'admin') }}
                </p>
            </div>
            <div class="flex">
                <a href="{{ relativeUrl(path('admin_generate_token', {'type': 'api'})) }}" type="button" class="btn--primary">
                    {{ "Generate an API key"|trans({}, 'admin') }}
                </a>
            </div>
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "MCP access"|trans({}, 'admin'),
        description: "Lets an AI assistant such as Claude or Cursor read your data through the MCP server. The key grants read access only, it cannot change anything."|trans({}, 'admin') ~ ' ' ~ "The allowed IP addresses above do not apply to it, the key is the only access control there."|trans({}, 'admin'),
    } %}
        {% block body %}
            {% if not mcpKey.isEmpty() and not mcpKey.hasValidFormat() %}
                <div class="flex items-start gap-3 p-3 rounded-lg bg-red-50 text-sm text-red-800" role="alert">
                    <svg class="size-5 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.6 3.5a1.6 1.6 0 0 1 2.8 0l7.7 13.8a1.6 1.6 0 0 1-1.4 2.4H4.3a1.6 1.6 0 0 1-1.4-2.4l7.7-13.8Z"/>
                    </svg>
                    <span>
                        {{ "{envVar} is set, but it is not a key this app generated, so the MCP server stays disabled. Generate a new one and replace it."|trans({'{envVar}': 'DREEVE_MCP_KEY'}, 'admin') }}
                    </span>
                </div>
            {% endif %}
            <div>
                <label for="mcpKeyState" class="mt-0!">{{ "MCP key"|trans({}, 'admin') }}</label>
                <input type="text" id="mcpKeyState" disabled
                       value="{{ mcpKey.isEmpty() ? "Not configured, MCP server is disabled"|trans({}, 'admin') : "Configured"|trans({}, 'admin') }}">
                <p class="description">
                    {{ "Set through the {envVar} environment variable and cannot be changed here."|trans({'{envVar}': 'DREEVE_MCP_KEY'}, 'admin') }}
                </p>
            </div>
            <div class="flex">
                <a href="{{ relativeUrl(path('admin_generate_token', {'type': 'mcp'})) }}" type="button" class="btn--primary">
                    {{ "Generate an MCP key"|trans({}, 'admin') }}
                </a>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock sections %}
