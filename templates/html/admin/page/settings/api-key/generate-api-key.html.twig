{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set overviewUrl = relativeUrl(path('admin_settings', {'group': 'security'})) %}
    <div class="modal-like-form">
        <div class="w-full min-w-0 max-w-xl overflow-y-auto p-6 bg-white border border-gray-200 rounded-lg shadow-xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">{{ "Generate an API key"|trans({}, 'admin') }}</h3>
                <a href="{{ overviewUrl }}" aria-label="{{ "Close"|trans({}, 'admin') }}"
                   class="grid place-items-center size-8 rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">
                    <svg class="size-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                    </svg>
                </a>
            </div>
            <p class="description mt-0!">
                {{ "The key lets an external client upload activity files over HTTP. It is the only thing guarding that endpoint, so treat it like a password."|trans({}, 'admin') }}
            </p>
            <ol class="mt-6 space-y-4">
                <li class="flex items-start gap-3">
                    <span class="grid size-6 shrink-0 place-items-center rounded-md bg-orange-100 text-xs font-bold text-primary">1</span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">{{ "Copy this API key"|trans({}, 'admin') }}</p>
                        <div class="mt-2 overflow-hidden rounded-xl border border-gray-200 bg-gray-50">
                            <div class="flex items-center justify-between border-b border-gray-200 bg-gray-100/70 px-3 py-1.5">
                                <span class="font-mono text-[11px] text-gray-400">DREEVE_API_KEY</span>
                            </div>
                            <div class="px-4 py-3 font-mono text-sm">
                                <code class="block overflow-x-auto whitespace-nowrap text-gray-800">{{ apiKey }}</code>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="grid size-6 shrink-0 place-items-center rounded-md bg-orange-100 text-xs font-bold text-primary">2</span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">{{ "Set {envVar} in your {envFile} file"|trans({'{envVar}': 'DREEVE_API_KEY', '{envFile}': '.env'}, 'admin') }}</p>
                        <p class="mt-0.5 text-sm text-gray-500">{{ "Paste the value above, replacing any key that is already there."|trans({}, 'admin') }}</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="grid size-6 shrink-0 place-items-center rounded-md bg-orange-100 text-xs font-bold text-primary">3</span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">{{ "Recreate your containers"|trans({}, 'admin') }}</p>
                        <div class="mt-2 overflow-hidden rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 font-mono text-sm">
                            <code class="block overflow-x-auto whitespace-nowrap text-gray-800">docker compose up -d --force-recreate</code>
                        </div>
                    </div>
                </li>
            </ol>
            <p class="mt-6 text-sm text-gray-500">
                {{ "This page shows a different key every time it is opened, and only the one in your environment file is applied."|trans({}, 'admin') }}
            </p>
            <div class="flex justify-end gap-2 border-t border-gray-200 pt-4 mt-6">
                <a href="{{ overviewUrl }}" type="button" class="btn--primary">{{ "Done"|trans({}, 'admin') }}</a>
            </div>
        </div>
    </div>
{% endblock main %}
