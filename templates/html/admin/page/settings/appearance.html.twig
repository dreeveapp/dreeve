{% extends "html/admin/page/settings/template.html.twig" %}
{% set settingsTitle = "Appearance"|trans({}, 'admin') %}

{% block sections %}
    {% set unitSystemOptions = enum('App\\Infrastructure\\Measurement\\UnitSystem').cases() %}
    {% set localeOptions = enum('App\\Infrastructure\\Localisation\\Locale').cases() %}
    {% set timeFormatOptions = enum('App\\Infrastructure\\Time\\Format\\TimeFormat').cases() %}
    {% set dateFormat = settings.dateFormat ?? {} %}
    {% set photos = settings.photos ?? {} %}
    {% set hidePhotosForSportTypes = photos.hidePhotosForSportTypes ?? [] %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {title: "Units & language"|trans({}, 'admin')} %}
        {% block body %}
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="unitSystem">{{ "Unit system"|trans({}, 'admin') }}</label>
                    <select id="unitSystem" name="data[unitSystem]">
                        {% for unitSystem in unitSystemOptions %}
                            <option value="{{ unitSystem.value }}" {{ (settings.unitSystem ?? 'metric') == unitSystem.value ? 'selected' : '' }}>{{ unitSystem.value }}</option>
                        {% endfor %}
                    </select>
                    <p class="description">
                        {{ "The unit system used to render distances, elevations, temperatures, etc."|trans({}, 'admin') }}
                    </p>
                </div>
                <div>
                    <label for="locale">{{ "Locale"|trans({}, 'admin') }}</label>
                    <select id="locale" name="data[locale]">
                        {% for locale in localeOptions %}
                            <option value="{{ locale.value }}" {{ (settings.locale ?? 'en_US') == locale.value ? 'selected' : '' }}>{{ locale.value }}</option>
                        {% endfor %}
                    </select>
                    <p class="description">
                        {{ "The locale used to render the app."|trans({}, 'admin') }}
                    </p>
                </div>
            </div>
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {title: "Date & time"|trans({}, 'admin')} %}
        {% block body %}
            <div class="grid gap-4 sm:grid-cols-3">
                <div>
                    <label for="timeFormat">{{ "Time format"|trans({}, 'admin') }}</label>
                    <select id="timeFormat" name="data[timeFormat]">
                        {% for timeFormat in timeFormatOptions %}
                            <option value="{{ timeFormat.value }}" {{ (settings.timeFormat ?? 24) == timeFormat.value ? 'selected' : '' }}>
                                {{ timeFormat.value == 24 ? "24-hour"|trans({}, 'admin') : "AM/PM"|trans({}, 'admin') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="dateFormatShort">{{ "Short date format"|trans({}, 'admin') }}</label>
                    <input type="text" id="dateFormatShort" name="data[dateFormat][short]" value="{{ dateFormat.short ?? 'd-m-y' }}" required>
                    <p class="description">
                        {{ "PHP date format for short dates, e.g. d-m-y renders to 01-01-25."|trans({}, 'admin') }}
                    </p>
                </div>
                <div>
                    <label for="dateFormatNormal">{{ "Normal date format"|trans({}, 'admin') }}</label>
                    <input type="text" id="dateFormatNormal" name="data[dateFormat][normal]" value="{{ dateFormat.normal ?? 'd-m-Y' }}" required>
                    <p class="description">
                        {{ "PHP date format for normal dates, e.g. d-m-Y renders to 01-01-2025."|trans({}, 'admin') }}
                    </p>
                </div>
            </div>
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Hide photos for sport types"|trans({}, 'admin'),
        description: "Photos of the selected sport types are excluded from the photo gallery."|trans({}, 'admin'),
    } %}
        {% block body %}
            {% include 'html/admin/component/checkbox-multiselect.html.twig' with {
                name: 'data[photos][hidePhotosForSportTypes][]',
                options: sportTypeOptions(),
                selected: hidePhotosForSportTypes,
                placeholder: "No sport types selected"|trans({}, 'admin'),
            } only %}
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Sport types sorting order"|trans({}, 'admin'),
        description: "Drag to set the order in which sport types are displayed throughout the app."|trans({}, 'admin'),
    } %}
        {% block body %}
            <div class="max-h-64 overflow-y-auto flex flex-col gap-1.5 rounded-lg border border-gray-200 p-2" data-sortable-list>
                {% for sportType in sportTypes %}
                    <div class="flex items-center gap-2 rounded-md border border-gray-200 bg-white px-2 py-1.5 shadow-xs" data-sort-item>
                        <span class="shrink-0 text-gray-400 cursor-grab active:cursor-grabbing" data-drag-handle title="{{ "Drag to reorder"|trans({}, 'admin') }}">
                            <svg class="size-4.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 6h.01M9 12h.01M9 18h.01M15 6h.01M15 12h.01M15 18h.01"/>
                            </svg>
                        </span>
                        <span class="min-w-0 truncate text-sm font-normal text-gray-800">{{ sportType|trans }}</span>
                        <input type="hidden" name="data[sportTypesSortingOrder][]" value="{{ sportType.value }}">
                    </div>
                {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock sections %}
