{% extends "html/admin/page/settings/template.html.twig" %}
{% set settingsTitle = "Daemon"|trans({}, 'admin') %}

{% block sections %}
    {% set cron = settings.cron ?? {} %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Scheduled actions"|trans({}, 'admin'),
        description: "Scheduled actions the daemon runs at regular intervals."|trans({}, 'admin'),
    } %}
        {% block body %}
            <div class="alert alert--info" role="alert">
                <span class="sr-only">{{ "Info"|trans({}, 'admin') }}</span>
                <div>
                    {{ "Changes to these settings only take effect after you restart the daemon container."|trans({}, 'admin') }}
                </div>
            </div>
            <div class="flex flex-col gap-3">
                {% for action in enum('App\\Infrastructure\\Daemon\\Cron\\CronActionId').cases()|filter(action => action.supportsImportMode(importMode)) %}
                    {% set actionId = action.value %}
                    {% set stored = cron[actionId] ?? {} %}
                    {% set defaultExpression = action.defaultCronExpression %}
                    <div class="flex flex-col gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                        <label class="flex items-center gap-2 mt-0! font-medium cursor-pointer">
                            <input type="checkbox" name="data[cron][{{ actionId }}][enabled]" value="1"
                                   {{ (stored.enabled ?? false) ? 'checked' : '' }}>
                            <span>{{ action|trans }}</span>
                        </label>
                        <p class="description mt-0!">{{ action|transDescription }}</p>
                        <div>
                            <label for="cron-{{ actionId }}">{{ "Cron expression"|trans({}, 'admin') }}</label>
                            <input type="text" id="cron-{{ actionId }}" name="data[cron][{{ actionId }}][expression]"
                                   value="{{ stored.expression ?? defaultExpression }}" required
                                   placeholder="{{ defaultExpression }}">
                            <p class="description">
                                {{ "Cron expression specifying when the action should run, e.g. '0 14 * * *' runs every day at 14:00. See crontab.guru for help."|trans({}, 'admin') }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}
    {% embed 'html/admin/page/settings/component/section.html.twig' with {
        title: "Backup"|trans({}, 'admin'),
        description: "Download the latest backup to keep a copy somewhere else or to move your data to another server."|trans({}, 'admin'),
    } %}
        {% block body %}
            {% if latestBackup %}
                <div>
                    <label for="latestBackup" class="mt-0!">{{ "Latest backup"|trans({}, 'admin') }}</label>
                    <input type="text" id="latestBackup" value="{{ latestBackup.filename }} ({{ latestBackup.sizeInMegaBytes|formatNumber(1) }} MB)" disabled>
                </div>
                <div class="flex">
                    <a href="{{ relativeUrl(path('admin_download_latest_backup')) }}" type="button" class="btn--primary">
                        {{ "Download latest backup"|trans({}, 'admin') }}
                    </a>
                </div>
            {% else %}
                {% set linkOpen = '<a class="font-semibold underline hover:no-underline" href="https://docs.dreeve.app/troubleshooting/faq/#backup--restore">' %}
                {% set linkClose = '</a>' %}
                <p class="text-sm text-gray-500">
                    {{ "There is no backup yet. Enable the local backup action above or create one by hand, as explained in {linkOpen}the documentation{linkClose}."|trans({'{linkOpen}': linkOpen, '{linkClose}': linkClose}, 'admin')|raw }}
                </p>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock sections %}
