{% autoescape false %}
    <a class="h-104 w-full flex flex-col items-center" href="{{ relativeUrl(path('activity', {'activityId': activity.getId()})) }}" target="_blank">
        <img class="max-h-full max-w-full rounded-lg lazy" data-src="{{ relativeUrl(mediaItem.getImageUrl()) }}" alt="{{ activity.getName() }}" src="{{ placeholderImage(mediaItem.getOrientation()) }}" />
    </a>
{% endautoescape %}