<div class="flex items-center justify-between gap-4 mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
        'url': 'heatmap',
        'label': 'Heatmap'|trans
    }], 'disableMargin': true} %}
    {% include 'html/navigation/admin-edit-link.html.twig' with {
        path: 'admin/settings/maps',
        redirectTo: 'heatmap',
        title: "Map settings"|trans,
        label: "Settings"|trans({}, 'admin'),
        icon: 'cog'
    } %}
</div>
{% autoescape false %}
    <div class="grid grid-cols-1 gap-y-2 heatmap-wrapper relative">
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <fieldset class="min-w-0 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed disabled:*:pointer-events-none" data-heatmap-filters>
                <form class="flex flex-col gap-y-2 mb-2" autocomplete="off">
                    <div class="flex flex-wrap gap-2">
                        {% if summary.getSportTypes()|length > 0 %}
                            {% include 'html/data-table/filter/sport-type.html.twig' with {sportTypes: summary.getSportTypes(), listClass: 'space-y-1'} only %}
                        {% endif %}
                        {% include 'html/data-table/filter/date-range.html.twig' with {name: 'start-date', label: "Date"|trans, withPresets: true} only %}
                        <div class="filter-dropdown">
                            {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'otherButton', dropdownId: 'dropdownOther', label: "Other"|trans} only %}
                            <div id="dropdownOther">
                                <div class="px-1 py-2 flex gap-x-2 divide-x divide-gray-100">
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium items-center">{{ "Commutes"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            <li>
                                                <div>
                                                    <input type="radio" id="true" data-dataTable-filter="isCommute" name="isCommute" value="true" class="peer" />
                                                    <label for="true">
                                                        {{ "Commutes only"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isCommute">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                            <li>
                                                <div>
                                                    <input type="radio" id="false" data-dataTable-filter="isCommute" name="isCommute" value="false" class="peer" />
                                                    <label for="false">
                                                        {{ "Excludes commutes"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isCommute">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium items-center">{{ "Group activities"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            <li>
                                                <div>
                                                    <input type="radio" id="isGroupActivity-true" data-dataTable-filter="isGroupActivity" name="isGroupActivity" value="true" class="peer" />
                                                    <label for="isGroupActivity-true">
                                                        {{ "Group activities only"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isGroupActivity">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                            <li>
                                                <div>
                                                    <input type="radio" id="isGroupActivity-false" data-dataTable-filter="isGroupActivity" name="isGroupActivity" value="false" class="peer" />
                                                    <label for="isGroupActivity-false">
                                                        {{ "Excludes group activities"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isGroupActivity">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium">{{ "Workout type"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            {% for workoutType in enum('App\\Domain\\Activity\\WorkoutType').cases() %}
                                                <li>
                                                    <div>
                                                        <input type="radio" id="{{ workoutType.value }}" data-dataTable-filter="workoutType" name="workoutType" value="{{ workoutType.value }}" class="peer" />
                                                        <label for="{{ workoutType.value }}">
                                                            {{ workoutType|trans }}
                                                        </label>
                                                        <a href="#" data-datatable-filter-clear="workoutType">{{ "clear"|trans }}</a>
                                                    </div>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="flex items-center justify-between gap-x-2 text-xs text-gray-700">
                    <div>
                        {% set numberOfResults = '<span class="font-bold" data-dataTable-result-count>' ~ summary.getNumberOfRoutes() ~ '</span>' %}
                        {{ "{numberOfResults} routes"|trans({'{numberOfResults}': numberOfResults}) }}
                    </div>
                    <a href="#" class="hidden font-medium text-primary hover:underline" data-dataTable-reset>{{ "Clear all filters"|trans }}</a>
                </div>
            </fieldset>
        </div>
        <!-- HEATMAP -->
        <div id="heatmap" data-heatmap-config='{{ heatmapConfig|json_encode}}' data-leaflet-routes='{{ relativeUrl(path('heatmap_routes')) }}'
             data-leaflet-countries='{{ relativeUrl(path('heatmap_countries')) }}' data-leaflet-countries-label='{{ "Highlight visited countries"|trans }}'
             data-leaflet-tiles='{{ relativeUrl(path('heatmap_tiles')) }}' data-leaflet-tiles-label='{{ "Highlight explorer tiles"|trans }}'
             data-leaflet-popup-labels='{{ {
                 'nearbyRoutes': "{numberOfRoutes} nearby route(s)"|trans({'{numberOfRoutes}': '{numberOfRoutes}'}),
             }|json_encode(constant('JSON_HEX_APOS')) }}'
             class="grid grid-cols-1 h-[calc(100vh-235px)] rounded-lg {{ heatmapConfig.getLeafletConfig().enableGreyScale() ? 'enable-grey-scale' : '' }}">
        </div>
        <div class="hidden lg:block z-10000 absolute bottom-3 left-3 py-2 px-4 bg-white border border-gray-200 rounded-lg shadow-xs text-xs">
            {% set percentage = (summary.getNumberOfCountries() / 195 * 100)|formatNumber(0) %}
            <div class="font-semibold text-gray-700 text-sm mb-0.5">{{ summary.getNumberOfCountries() }} {{ "countries"|trans }}</div>
            <div class="text-gray-500"> {{ "That's {percentage}% of all countries 🌍"|trans({'{percentage}': percentage}) }}</div>
            <div class="hidden mt-2 pt-2 border-t border-gray-200 max-w-64" data-heatmap-tiles-stats>
                <div class="font-semibold text-gray-700 text-sm mb-0.5">{{ "Explorer tiles"|trans }}</div>
                <div class="text-gray-500 mb-1.5">{{ "Explorer tiles include all your activities"|trans }}</div>
                <div class="grid grid-cols-[auto_1fr_auto] items-center gap-x-2 gap-y-1 text-gray-700">
                    <span class="size-3 rounded-xs border" data-heatmap-tiles-swatch="visited"></span>
                    <span class="cursor-help underline decoration-dotted decoration-gray-400 underline-offset-2" title="{{ "Map tiles at zoom level 14 that your activities passed through"|trans }}">{{ "Visited tiles"|trans }}</span>
                    <span class="font-semibold text-right" data-heatmap-tiles-stat="total"></span>
                    <span class="size-3 rounded-xs border" data-heatmap-tiles-swatch="cluster"></span>
                    <span class="cursor-help underline decoration-dotted decoration-gray-400 underline-offset-2" title="{{ "A cluster tile is a visited tile whose four neighbours are visited too"|trans }}">{{ "Cluster tiles"|trans }}</span>
                    <span class="font-semibold text-right" data-heatmap-tiles-stat="clusterTiles"></span>
                    <span class="size-3 rounded-xs border" data-heatmap-tiles-swatch="maxCluster"></span>
                    <span class="cursor-help underline decoration-dotted decoration-gray-400 underline-offset-2" title="{{ "The largest connected group of cluster tiles"|trans }}">{{ "Max cluster"|trans }}</span>
                    <span class="font-semibold text-right" data-heatmap-tiles-stat="maxCluster"></span>
                    <span class="size-3 rounded-xs border-2" data-heatmap-tiles-swatch="maxSquare"></span>
                    <span class="cursor-help underline decoration-dotted decoration-gray-400 underline-offset-2" title="{{ "The largest square of visited tiles"|trans }}">{{ "Max square"|trans }}</span>
                    <span class="font-semibold text-right" data-heatmap-tiles-stat="maxSquare"></span>
                </div>
            </div>
        </div>
    </div>
{% endautoescape %}