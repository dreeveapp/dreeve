<div class="flex items-center justify-between gap-4 mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
        'url': 'segments',
        'label': 'Segments'|trans
    }], 'disableMargin': true} %}
    {% if importMode.isFiles() %}
        {% include 'html/navigation/admin-edit-link.html.twig' with {
            path: 'admin/segments',
            redirectTo: 'segments',
            title: "Manage segments"|trans,
            label: "Manage"|trans({}, 'admin')
        } %}
    {% endif %}
</div>
{% autoescape false %}
    <div class="grid grid-cols-1 gap-4">
        <!-- SEGMENTS -->
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <div data-dataTable-settings='{"url":"{{ relativeUrl(path('segment_data_table')) }}","name":"segments"}' class="relative">
                <form class="flex flex-col gap-y-2 mb-2" autocomplete="off">
                    <div class="flex items-center">
                        <label for="search" class="sr-only">{{ "Search"|trans }}</label>
                        <div class="relative w-full">
                            <div class="absolute inset-y-0 inset-s-0 flex items-center ps-3 pointer-events-none">
                                <svg class="size-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                                </svg>
                            </div>
                            <input id="search" type="search" placeholder="{{ "Search segment..."|trans }}" class="table-search bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition block w-full ps-10 p-2.5">
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% if sportTypes|length > 0 %}
                            {% include 'html/data-table/filter/sport-type.html.twig' with {sportTypes: sportTypes} only %}
                        {% endif %}
                        {% if countries|length > 0 %}
                            {% include 'html/data-table/filter/country.html.twig' with {countries: countries, label: "Country"|trans} only %}
                        {% endif %}
                        <div class="filter-dropdown">
                            {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'distanceButton', dropdownId: 'dropdownDistance', label: "Distance"|trans} only %}
                            <div id="dropdownDistance">
                                <div class="p-3 flex flex-col gap-y-2">
                                    {% include 'html/data-table/filter/range.html.twig' with {name: 'distance', label: "Distance"|trans, icon: 'distance', unit: renderUnitSymbol('distance')} only %}
                                </div>
                            </div>
                        </div>
                        <div class="filter-dropdown">
                            {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'gradientButton', dropdownId: 'dropdownGradient', label: "Gradient"|trans} only %}
                            <div id="dropdownGradient">
                                <div class="p-3 flex flex-col gap-y-2">
                                    {% include 'html/data-table/filter/range.html.twig' with {name: 'averageGradient', label: "Average gradient"|trans, icon: 'percentage', unit: '%', allowNegative: true} only %}
                                    {% include 'html/data-table/filter/range.html.twig' with {name: 'maxGradient', label: "Max gradient"|trans, icon: 'percentage', unit: '%', allowNegative: true} only %}
                                </div>
                            </div>
                        </div>
                        {% include 'html/data-table/filter/date-range.html.twig' with {name: 'lastEffortDate', label: "Last effort date"|trans} only %}
                        <div class="filter-dropdown">
                            {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'dropdownOtherButton', dropdownId: 'dropdownOther', label: "Other"|trans} only %}
                            <div id="dropdownOther" class="divide-y divide-gray-100">
                                <ul aria-labelledby="dropdownOtherButton">
                                    <li>
                                        <div>
                                            <input type="checkbox" id="isFavourite" data-dataTable-filter="isFavourite" name="isFavourite" value="isFavourite" class="peer" />
                                            <label for="isFavourite" class="w-full peer-checked:border-primary">
                                                    <span class="flex gap-x-1 items-center">
                                                        {{ svg('star') }}
                                                        <div>{{ "Favourite"|trans }}</div>
                                                    </span>
                                                <span class="text-xs font-normal text-gray-500">{{ "Filter on starred segments"|trans }}</span>
                                            </label>
                                        </div>
                                    </li>
                                    <li>
                                        <div>
                                            <input type="checkbox" id="isKom" data-dataTable-filter="isKom" name="isKom" value="isKom" class="peer" />
                                            <label for="isKom" class="w-full peer-checked:border-primary">
                                                    <span class="flex gap-x-1 items-center">
                                                        {{ svg('elevation', 'h-4 shrink-0') }}
                                                        <div>{{ "KOM"|trans }}</div>
                                                    </span>
                                                <span class="text-xs font-normal text-gray-500">{{ "Filter on KOM segments"|trans }}</span>
                                            </label>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between gap-x-2 text-xs text-gray-700">
                        <div>
                            {% set numberOfResults = '<span class="font-bold" data-dataTable-result-count>' ~ totalSegmentCount ~ '</span>' %}
                            {{ "{numberOfResults} results"|trans({'{numberOfResults}': numberOfResults}) }}
                        </div>
                        <a href="#" class="hidden font-medium text-primary hover:underline" data-dataTable-reset>{{ "Clear all filters"|trans }}</a>
                    </div>
                </form>
                <div class="scroll-area overflow-auto max-h-[calc(100vh-285px)]">
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th scope="col" data-dataTable-sort="name" class="narrow">
                                <div class="w-92 flex items-center">
                                    {{ "Title"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="last-effort-date" class="narrow">
                                <div class="flex items-center justify-center" title="{{ "Last effort"|trans }}">
                                    {{ "Last effort"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col">
                                <div class="flex items-center justify-center" title="{{ "Best effort"|trans }}">
                                    {{ "Best effort"|trans }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="distance" title="{{ "Distance"|trans }}">
                                <div class="flex items-center justify-center">
                                    {{ "Dist."|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="average-gradient" title="{{ "Average gradient"|trans }}">
                                <div class="flex items-center justify-center">
                                    {{ "Grad."|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="ride-count" title="{{ "Number of times completed"|trans }}">
                                <div class="flex items-center justify-center">
                                    {{ "# completed"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                        </tr>
                        </thead>
                        <tbody class="clusterize-content">
                        <tr class="clusterize-loading">
                            <td colspan="100">
                                <div>
                                    {% include 'html/loader.html.twig' with {modifier: 'loader--sm'} %}
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endautoescape %}