<dialog data-release-announcement
        aria-labelledby="release-announcement-title"
        class="m-auto w-full max-w-md rounded-lg border border-gray-200 bg-white text-gray-900 shadow-xl backdrop:bg-[#000]/50">
    <div class="p-6">
        <h3 id="release-announcement-title" class="text-lg font-semibold mb-2">{{ "New version available"|trans }}</h3>
        <p class="text-sm text-gray-600 mb-4">{{ "A new version of Dreeve is available. Read the release notes before updating, they might contain breaking changes."|trans }}</p>
        <dl class="grid grid-cols-2 gap-y-1 text-sm mb-6">
            <dt class="text-gray-500">{{ "Current version"|trans }}</dt>
            <dd class="font-medium text-right">{{ appVersion.getSemanticVersion() }}</dd>
            <dt class="text-gray-500">{{ "Latest version"|trans }}</dt>
            <dd class="font-medium text-right">[LATEST_VERSION]</dd>
        </dl>
        <form method="dialog" class="flex justify-end gap-2 border-t border-gray-200 pt-4">
            <a href="https://github.com/dreeveapp/dreeve/releases/tag/[LATEST_VERSION]" target="_blank" rel="noopener"
               class="inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900">
                {{ "Release notes"|trans }}
            </a>
            <button type="submit" class="inline-flex cursor-pointer items-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:brightness-95">
                {{ "Got it"|trans }}
            </button>
        </form>
    </div>
</dialog>
