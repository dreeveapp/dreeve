<dialog data-release-announcement
        aria-labelledby="release-announcement-title"
        class="m-auto w-full max-w-sm rounded-2xl border border-gray-200 bg-white text-gray-900 shadow-xl backdrop:bg-[#000]/50">
    <div class="relative flex flex-col items-center gap-4 p-6 text-center">
        <form method="dialog" class="absolute top-3 right-3">
            <button type="submit" aria-label="{{ "Close"|trans }}"
                    class="grid size-8 cursor-pointer place-items-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">
                <svg class="size-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                </svg>
            </button>
        </form>
        <span class="grid size-14 place-items-center rounded-full bg-primary-soft" aria-hidden="true">
            {{ svg('rocket', 'size-7') }}
        </span>
        <div class="space-y-2">
            <h3 id="release-announcement-title" class="text-lg font-semibold">{{ "New version available"|trans }}</h3>
            <p class="text-sm text-gray-600">{{ "We've been busy! Check out what's new and read about any breaking changes before you update."|trans }}</p>
        </div>
        <div class="flex items-center gap-2 text-sm font-medium">
            <span class="rounded-full bg-gray-100 px-3 py-1 text-gray-600">{{ appVersion.getSemanticVersion() }}</span>
            <svg class="size-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/>
            </svg>
            <span class="rounded-full bg-primary-soft px-3 py-1 text-primary">[LATEST_VERSION]</span>
        </div>
        <a href="https://github.com/dreeveapp/dreeve/releases/tag/[LATEST_VERSION]" target="_blank" rel="noopener"
           class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:brightness-95">
            {{ "See what's new"|trans }}
            <svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 14v4.833A1.166 1.166 0 0 1 16.833 20H5.167A1.167 1.167 0 0 1 4 18.833V7.167A1.166 1.166 0 0 1 5.167 6h4.618m4.447-2H20v5.768m-7.889 2.121 7.778-7.778"/>
            </svg>
        </a>
    </div>
</dialog>
