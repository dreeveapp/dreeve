{% set dashboardCrumb %}
    <svg class="size-5 mr-2.5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
    {{ "Dashboard"|trans }}
{% endset %}
<nav class="flex {{ disableMargin ? '' : 'mb-5' }}" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2">
        <li class="inline-flex items-center">
            {% if breadcrumbs is empty %}
                <span aria-current="page" class="inline-flex items-center text-gray-700">{{ dashboardCrumb }}</span>
            {% else %}
                <a href="{{ relativeUrl('dashboard') }}" data-router-link class="inline-flex items-center text-gray-700 hover:text-primary-600 hover:underline">{{ dashboardCrumb }}</a>
            {% endif %}
        </li>
        {% for breadcrumb in breadcrumbs %}
            <li>
                <div class="flex items-center">
                    <svg class="size-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                    {% if loop.last %}
                        <span aria-current="page" class="ml-1 text-gray-700 md:ml-2">{{ breadcrumb.label }}</span>
                    {% else %}
                        <a href="{{ relativeUrl(breadcrumb.url) }}" data-router-link class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2">{{ breadcrumb.label }}</a>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ol>
</nav>
