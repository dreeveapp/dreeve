<div class="flex items-center justify-between gap-4 mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
        'url': 'collections',
        'label': 'Activity collections'|trans
    }], 'disableMargin': true} %}
    {% include 'html/navigation/admin-edit-link.html.twig' with {
        path: 'admin/collections',
        redirectTo: 'collections',
        title: "Manage activity collections"|trans,
        label: "Manage"|trans({}, 'admin')
    } %}
</div>
{% autoescape false %}
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
        {% for year, summaries in summariesPerYear %}
            <h3 class="text-lg font-semibold mb-4 {{ not loop.first ? 'mt-6' }}">{{ year }}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for summary in summaries %}
                    {% set activityCollection = summary.getActivityCollection() %}
                    <div class="flex flex-col gap-3 rounded-lg border border-gray-200 p-3 shadow-xs">
                        <div class="no-dark h-40 relative overflow-hidden rounded-lg bg-gray-200">
                            <img class="absolute inset-0 size-full object-cover" loading="lazy"
                                 src="{{ activityCollection.getCoverImagePath() ? relativeUrl(activityCollection.getCoverImagePath()) : placeholderImage() }}"
                                 alt="{{ activityCollection.getName()|e('html_attr') }}"/>
                            <div class="absolute top-3 left-3">
                                <span class="pill pill--neutral text-xs">{{ activityCollection.getType()|trans }}</span>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center gap-1.5 font-semibold text-gray-900">
                                {% set countryCodes = summary.getCountryCodes() %}
                                {% if countryCodes is not empty %}
                                    <span class="flex items-center gap-1">
                                        {% for countryCode in countryCodes %}
                                            <img src="{{ countryCode|countryIcon }}" width="15" class="rounded-xs" alt="{{ countryCode|upper }}">
                                        {% endfor %}
                                    </span>
                                {% endif %}
                                <span class="truncate" title="{{ activityCollection.getName()|e('html_attr') }}">{{ activityCollection.getName()|e }}</span>
                            </div>
                            <div class="flex items-center gap-1.5 mt-1 text-xs text-gray-500">
                                {{ svg('calendar', 'size-3.5', 'text-gray-400') }}
                                <span>
                                    {{ summary.getStartDate()|formatDate('normal') }}
                                    {% if summary.getNumberOfDays() > 1 %}
                                        &ndash; {{ summary.getEndDate()|formatDate('normal') }}
                                    {% endif %}
                                    &middot; {{ "{numberOfDays} days"|trans({'{numberOfDays}': summary.getNumberOfDays()}) }}
                                </span>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="bg-white rounded-lg p-2.5 border border-gray-200 shadow-xs">
                                <div class="text-xxs uppercase tracking-wider font-semibold text-gray-500 mb-1">{{ "Distance"|trans }}</div>
                                <div class="flex items-baseline gap-1">
                                    {% set distance = summary.getDistance() %}
                                    <span class="text-lg font-black tracking-tight text-gray-900">{{ distance|formatMeasurement(0) }}</span>
                                    <span class="text-xs font-medium text-gray-500">{{ distance|measurementSymbol }}</span>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg p-2.5 border border-gray-200 shadow-xs">
                                <div class="text-xxs uppercase tracking-wider font-semibold text-gray-500 mb-1">{{ "Elevation"|trans }}</div>
                                <div class="flex items-baseline gap-1">
                                    {% set elevation = summary.getElevation() %}
                                    <span class="text-lg font-black tracking-tight text-gray-900">{{ elevation|formatMeasurement(0) }}</span>
                                    <span class="text-xs font-medium text-gray-500">{{ elevation|measurementSymbol }}</span>
                                </div>
                            </div>
                            <div class="bg-white rounded-lg p-2.5 border border-gray-200 shadow-xs">
                                <div class="text-xxs uppercase tracking-wider font-semibold text-gray-500 mb-1">{{ "Activities"|trans }}</div>
                                <span class="text-lg font-black tracking-tight text-gray-900">{{ summary.getActivities()|length }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endautoescape %}
