<div class="flex items-center justify-between gap-4 mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
        'url': 'activities',
        'label': 'Activities'|trans
    }], 'disableMargin': true} %}
    {% include 'html/navigation/admin-edit-link.html.twig' with {
        path: 'admin/activities',
        redirectTo: 'activities',
        title: "Manage activities"|trans,
        label: "Manage"|trans({}, 'admin')
    } %}
</div>
{% autoescape false %}
    <!-- ALL ACTIVITIES -->
    <div class="grid grid-cols-1">
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <!--HTML-->
            <div data-dataTable-settings='{"url":"{{ relativeUrl(path('activity_data_table')) }}","name":"activities","toggleableColumns":true}' class="relative">
                <form class="flex flex-col gap-y-2 mb-2" autocomplete="off">
                    <div class="flex items-center">
                        <label for="search" class="sr-only">Search</label>
                        <div class="relative w-full">
                            <div class="absolute inset-y-0 inset-s-0 flex items-center ps-3 pointer-events-none">
                                <svg class="size-4 text-gray-500" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                                </svg>
                            </div>
                            <input id="search" type="search" placeholder="{{ "Search activity..."|trans }}"
                                   class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition block w-full ps-10 p-2.5">
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% if sportTypes|length > 0 %}
                            {% include 'html/data-table/filter/sport-type.html.twig' with {sportTypes: sportTypes} only %}
                        {% endif %}
                        {% include 'html/data-table/filter/date-range.html.twig' with {name: 'start-date', label: "Date"|trans, withPresets: true} only %}
                        {% if countries|length > 0 %}
                            {% include 'html/data-table/filter/country.html.twig' with {countries: countries, label: "Country"|trans} only %}
                        {% endif %}
                        {% if gears|length > 0 %}
                            <div class="filter-dropdown">
                                {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'dropdownGearsButton', dropdownId: 'dropdownGears', label: "Gear"|trans} only %}
                                <div id="dropdownGears" class="divide-y divide-gray-100">
                                    <ul aria-labelledby="dropdownGearsButton">
                                        {% for gear in gears %}
                                            <li>
                                                <div>
                                                    <input type="radio" id="{{ gear.getId() }}" data-dataTable-filter="gear" name="gear" value="{{ gear.getId() }}" class="peer" />
                                                    <label for="{{ gear.getId() }}">
                                                        <span>{{ gear.getName() }}</span>
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="gear">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        {% endfor %}
                                        <li>
                                            <div>
                                                <input type="radio" id="gear-none" data-dataTable-filter="gear" name="gear" value="gear-none" class="peer" />
                                                <label for="gear-none">
                                                    <span>{{ "Unspecified"|trans }}</span>
                                                </label>
                                                <a href="#" data-datatable-filter-clear="gear">{{ "clear"|trans }}</a>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                        {% if devices|length > 0 %}
                            <div class="filter-dropdown">
                                {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'dropdownDevicesButton', dropdownId: 'dropdownDevices', label: "Device"|trans} only %}
                                <div id="dropdownDevices" class="divide-y divide-gray-100">
                                    <ul aria-labelledby="dropdownDevicesButton">
                                        {% for device in devices %}
                                            <li>
                                                <div>
                                                    <input type="radio" id="{{ device.getId() }}" data-dataTable-filter="device" name="device" value="{{ device.getId() }}" class="peer" />
                                                    <label for="{{ device.getId() }}">
                                                        <span>{{ device.getName() }}</span>
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="device">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        {% endfor %}
                                        <li>
                                            <div>
                                                <input type="radio" id="recordingDevice-none" data-dataTable-filter="device" name="device" value="recordingDevice-none" class="peer" />
                                                <label for="recordingDevice-none">
                                                    <span>{{ "Unspecified"|trans }}</span>
                                                </label>
                                                <a href="#" data-datatable-filter-clear="device">{{ "clear"|trans }}</a>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                        <div class="filter-dropdown">
                            {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'distanceElevationButton', dropdownId: 'dropdownDistanceElevation', label: "Distance & Elevation"|trans} only %}
                            <div id="dropdownDistanceElevation">
                                <div class="p-3 flex flex-col gap-y-2">
                                    {% include 'html/data-table/filter/range.html.twig' with {name: 'distance', label: "Distance"|trans, icon: 'distance', unit: renderUnitSymbol('distance')} only %}
                                    {% include 'html/data-table/filter/range.html.twig' with {name: 'elevation', label: "Elevation"|trans, icon: 'elevation', unit: renderUnitSymbol('elevation')} only %}
                                </div>
                            </div>
                        </div>
                        <div class="filter-dropdown">
                            {% include 'html/data-table/filter/dropdown-button.html.twig' with {buttonId: 'otherButton', dropdownId: 'dropdownOther', label: "Other"|trans} only %}
                            <div id="dropdownOther">
                                <div class="px-1 py-2 flex gap-x-2 divide-x divide-gray-100">
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium items-center">{{ "Commutes"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            <li>
                                                <div>
                                                    <input type="radio" id="true" data-dataTable-filter="isCommute" name="isCommute" value="true" class="peer" />
                                                    <label for="true">
                                                        {{ "Commutes only"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isCommute">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                            <li>
                                                <div>
                                                    <input type="radio" id="false" data-dataTable-filter="isCommute" name="isCommute" value="false" class="peer" />
                                                    <label for="false">
                                                        {{ "Excludes commutes"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isCommute">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium items-center">{{ "Group activities"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            <li>
                                                <div>
                                                    <input type="radio" id="isGroupActivity-true" data-dataTable-filter="isGroupActivity" name="isGroupActivity" value="true" class="peer" />
                                                    <label for="isGroupActivity-true">
                                                        {{ "Group activities only"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isGroupActivity">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                            <li>
                                                <div>
                                                    <input type="radio" id="isGroupActivity-false" data-dataTable-filter="isGroupActivity" name="isGroupActivity" value="false" class="peer" />
                                                    <label for="isGroupActivity-false">
                                                        {{ "Excludes group activities"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="isGroupActivity">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium">{{ "Workout type"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            {% for workoutType in enum('App\\Domain\\Activity\\WorkoutType').cases() %}
                                                <li>
                                                    <div>
                                                        <input type="radio" id="{{ workoutType.value }}" data-dataTable-filter="workoutType" name="workoutType" value="{{ workoutType.value }}" class="peer" />
                                                        <label for="{{ workoutType.value }}">
                                                            {{ workoutType|trans }}
                                                        </label>
                                                        <a href="#" data-datatable-filter-clear="workoutType">{{ "clear"|trans }}</a>
                                                    </div>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="filter-dropdown filter-dropdown--icon ms-auto">
                            <button id="dropdownColumnsButton" data-dropdown="dropdownColumns" data-dropdown-placement="bottom-end" data-dropdown-offset-distance="10" data-dropdown-offset-skidding="0" type="button" title="{{ "Columns"|trans }}">
                                {{ svg('columns') }}
                                <span class="sr-only">{{ "Columns"|trans }}</span>
                            </button>
                            <div id="dropdownColumns" class="divide-y divide-gray-100">
                                <ul aria-labelledby="dropdownColumnsButton" data-dataTable-columns></ul>
                                <div class="p-3">
                                    <a href="#" class="text-primary text-sm underline" data-dataTable-columns-reset>{{ "Show all columns"|trans }}</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between gap-x-2 text-xs text-gray-700">
                        <div>
                            {% set numberOfResults = '<span class="font-bold" data-dataTable-result-count>' ~ activityTotals.getTotalActivities() ~ '</span>' %}
                            {{ "{numberOfResults} results"|trans({'{numberOfResults}': numberOfResults}) }}
                        </div>
                        <a href="#" class="hidden font-medium text-primary hover:underline" data-dataTable-reset>{{ "Clear all filters"|trans }}</a>
                    </div>
                </form>
                <div class="scroll-area overflow-auto max-h-[calc(100vh-285px)]">
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th class="narrow" scope="col" data-dataTable-sort="start-date" data-dataTable-column="start-date">
                                <div class="flex items-center justify-center" title="{{ "Date"|trans }}">
                                    {{ "Date"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" class="narrow text-left bg-gray-50 lg:sticky lg:left-0">
                                <div class="w-92">{{ "Title"|trans }}</div>
                            </th>
                            <th scope="col" data-dataTable-sort="distance" data-dataTable-column="distance">
                                <div class="flex items-center justify-center" title="{{ "Distance"|trans }}">
                                    {{ "Dist."|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="elevation" data-dataTable-column="elevation">
                                <div class="flex items-center justify-center" title="{{ "Elevation"|trans }}">
                                    {{ "Elev."|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="moving-time" data-dataTable-column="moving-time">
                                <div class="flex items-center justify-center" title="{{ "Moving time"|trans }}">
                                    {{ "Moving time"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="speed" data-dataTable-column="speed">
                                <div class="flex items-center justify-center" title="{{ "Speed"|trans }}">
                                    {{ "Speed"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="heart-rate" data-dataTable-column="heart-rate">
                                <div class="flex items-center justify-center" title="{{ "Heart rate"|trans }}">
                                    {{ "HR"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="calories" data-dataTable-column="calories">
                                <div class="flex items-center justify-center" title="{{ "Calories burned"|trans }}">
                                    {{ "Cal."|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power" data-dataTable-column="power">
                                <div class="flex items-center justify-center" title="{{ "Power"|trans }}">
                                    {{ "Power"|trans }}
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-5s" data-dataTable-column="power-5s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 5s
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-10s" data-dataTable-column="power-10s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 10s
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-30s" data-dataTable-column="power-30s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 30s
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-60s" data-dataTable-column="power-60s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 1m
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-300s" data-dataTable-column="power-300s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 5m
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-480s" data-dataTable-column="power-480s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 8m
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-1200s" data-dataTable-column="power-1200s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 20m
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                            <th scope="col" data-dataTable-sort="power-3600s" data-dataTable-column="power-3600s" colspan="2">
                                <div class="flex items-center justify-center">
                                    {{ "Best"|trans }} 1h
                                    {{ svg('sorting-icon') }}
                                </div>
                            </th>
                        </tr>
                        </thead>
                        <tbody class="clusterize-content">
                        <tr class="clusterize-loading">
                            <td colspan="100">
                                <div>
                                    {% include 'html/loader.html.twig' with {modifier: 'loader--sm'} %}
                                </div>
                            </td>
                        </tr>
                        </tbody>
                        <tfoot>
                        <tr>
                            <th class="narrow" scope="col">

                            </th>
                            <th scope="col" class="narrow bg-gray-50 lg:sticky lg:left-0">

                            </th>
                            <th scope="col">
                                <span data-dataTable-summable="distance">{{ activityTotals.getTotalDistance()|formatMeasurement(0) }}</span> {{ renderUnitSymbol('distance') }}
                            </th>
                            <th scope="col">
                                <span data-dataTable-summable="elevation">{{ activityTotals.getTotalElevation()|formatMeasurement(0) }}</span> {{ renderUnitSymbol('elevation') }}
                            </th>
                            <th scope="col">
                                <span data-dataTable-summable="moving-time">{{ activityTotals.getMovingTimeInHours()|formatNumber(0) }}</span> h
                            </th>
                            <th scope="col">
                            </th>
                            <th scope="col">
                            </th>
                            <th scope="col">
                                <span data-dataTable-summable="calories">{{ activityTotals.getTotalCalories()|formatNumber(0) }}</span> kcal
                            </th>
                            <th scope="col">
                            </th>
                            <th scope="col" colspan="2">

                            </th>
                            <th scope="col" colspan="2">

                            </th>
                            <th scope="col" colspan="2">
                            </th>
                            <th scope="col" colspan="2">

                            </th>
                            <th scope="col" colspan="2">

                            </th>
                            <th scope="col" colspan="2">

                            </th>
                            <th scope="col" colspan="2">

                            </th>
                            <th scope="col" colspan="2">

                            </th>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endautoescape %}