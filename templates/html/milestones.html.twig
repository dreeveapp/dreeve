{% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
    'url': 'milestones',
    'label': 'Milestones'|trans
}]} %}
{% if milestones.isEmpty() %}
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs text-center text-gray-500">
        {{ "No milestones achieved yet"|trans }}
    </div>
{% else %}
    {% if milestones.getUniqueFilterGroups()|length > 1 %}
        <div class="flex gap-2 mb-6 overflow-x-auto" data-milestone-filters>
            <div class="shrink-0">
                <input type="radio" id="all" value="all" name="filter-group" class="hidden peer" required="" checked>
                <label for="all" class="inline-flex items-center justify-between gap-x-1 rounded-lg cursor-pointer px-3 py-2 text-sm font-medium shadow-xs bg-white border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 peer-checked:text-primary peer-checked:border-primary peer-checked:bg-primary-soft peer-checked:hover:text-primary peer-checked:hover:bg-primary/20 transition-colors">
                    {{ "All"|trans }}
                </label>
            </div>
            {% for group in milestones.getUniqueFilterGroups() %}
                <div class="shrink-0">
                    <input type="radio" id="{{ group.value }}" value="{{ group.value }}" name="filter-group" class="hidden peer" required="">
                    <label for="{{ group.value }}" class="inline-flex items-center justify-between gap-x-1 rounded-lg cursor-pointer px-3 py-2 text-sm font-medium shadow-xs bg-white border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 peer-checked:text-primary peer-checked:border-primary peer-checked:bg-primary-soft peer-checked:hover:text-primary peer-checked:hover:bg-primary/20 transition-colors">
                        {{ svg(group.getSvgIcon(), 'size-4', '') }}
                        <span>{{ group|trans }}</span>
                    </label>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    <div class="relative border-l-2 border-gray-200 ml-6">
        {% set currentYear = null %}
        {% for milestone in milestones %}
            {% set milestoneYear = milestone.getAchievedOn().getYear() %}
            {% if milestoneYear != currentYear %}
                {% set currentYear = milestoneYear %}
                <div class="relative mb-8 -ml-4" data-milestone-year-separator>
                    <div class="flex items-center gap-x-3">
                        <div class="size-8 rounded-full bg-primary-soft dark:bg-[#202830] flex items-center justify-center ring-8 ring-gray-50">
                            {{ svg('calendar', 'size-4', 'text-primary') }}
                        </div>
                        <span class="text-sm font-bold text-gray-700">{{ currentYear }}</span>
                    </div>
                </div>
            {% endif %}
            <div class="mb-8 ml-10" id="{{ milestone.getId() }}" data-milestone-filter-group="{{ milestone.getCategory().getFilterGroup().value }}">
                <div class="absolute -inset-s-10">
                    <div class="flex flex-col items-center gap-y-1 w-20">
                        <div class="flex items-center justify-center size-8 bg-white rounded-full ring-8 ring-gray-50 border border-gray-200">
                            {{ svg(milestone.getCategory().getFilterGroup().getSvgIcon(), 'size-4', 'text-primary') }}
                        </div>
                        <time class="text-xs text-gray-500 bg-gray-50 pb-1.25">{{ milestone.getAchievedOn()|formatDate('normal') }}</time>
                    </div>
                </div>
                <div data-scroll-to-highlight class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
                    <div class="flex items-center gap-x-1 mb-1">
                        {% if milestone.getSportType() %}
                            <div class="shrink-0 px-2 py-0.5 text-xxs font-medium border border-gray-200 text-primary bg-white rounded-lg">
                                {{ milestone.getSportType()|trans }}
                            </div>
                        {% endif %}
                        <h3 class="text-sm md:text-base font-bold text-gray-900 truncate">{{ _self.milestoneTitle(milestone) }}</h3>
                    </div>
                    <div class="text-sm text-gray-600">
                        {% if milestone.getActivityId() %}
                            {% set activity = activitiesPerActivityId[milestone.getActivityId()] %}
                            {{ activity|activityLink }}
                        {% endif %}
                    </div>
                    {% if milestone.getFunComparison() %}
                        <div class="mt-1 text-sm italic text-gray-500 truncate">
                            {{ milestone.getFunComparison()|trans }}
                        </div>
                    {% endif %}
                    {% if milestone.getCategory() == enum('App\\Domain\\Milestone\\MilestoneCategory').EDDINGTON  %}
                        <div class="mt-1 text-sm italic text-gray-500 truncate">
                            {{ "That's {number} days of at least {distance}"|trans({
                                '{number}': milestone.getContext().getNumber(),
                                '{distance}':  milestone.getContext().getDistance()|renderMeasurement(0)})|raw
                            }}
                        </div>
                    {% endif %}
                    {% if milestone.getPrevious() %}
                        {% set previousMilestone = milestone.getPrevious() %}
                        <div class="mt-1 text-xs text-gray-400">
                            {{ "Previous"|trans }}:
                            <a href="javascript:void(0)" data-scroll-to="{{ previousMilestone.getPreviousMilestoneId() }}" class="text-gray-500 hover:text-gray-600">
                                {{ _self.previousMilestoneThreshold(milestone.getCategory(), previousMilestone) }}</a>
                            {{ "on"|trans }} {{ previousMilestone.getAchievedOn()|formatDate('normal') }}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% macro milestoneTitle(milestone) %}
    {% set categoryEnum = enum('App\\Domain\\Milestone\\MilestoneCategory') %}
    {% set context = milestone.getContext() %}
    {% set milestoneCategory = milestone.getCategory() %}

    {% if milestoneCategory == categoryEnum.FIRST_ACTIVITY_IN_COUNTRY %}
        <div class="flex gap-x-1 items-center">
            <span>{{ "First activity in {countryName}"|trans({'{countryName}': context.getCountryName()}) }}</span>
            <img src="{{ context.getCountryCode()|countryIcon }}" width="15" class="rounded-xs" title="{{ context.getCountryName() }}" alt="{{ context.getCountryName() }}">
        </div>
    {% elseif milestoneCategory == categoryEnum.FIRST_ACTIVITY_OF_SPORT_TYPE %}
        {{ "First-ever activity recorded"|trans }}
    {% elseif milestoneCategory == categoryEnum.ACTIVITY_COUNT %}
        {{ "Completed {threshold} activities"|trans({'{threshold}': context.getThreshold()|formatNumber(0)}) }}
    {% elseif milestoneCategory == categoryEnum.CUMULATIVE_DISTANCE %}
        {{ "Reached {threshold} total distance"|trans({'{threshold}': context.getThreshold()|renderMeasurement(0)})|raw }}
    {% elseif milestoneCategory == categoryEnum.CUMULATIVE_ELEVATION %}
        {{ "Reached {threshold} total elevation"|trans({'{threshold}': context.getThreshold()|renderMeasurement(0)})|raw }}
    {% elseif milestoneCategory == categoryEnum.CUMULATIVE_MOVING_TIME %}
        {{ "Reached {threshold} hours total moving time"|trans({'{threshold}': context.getThreshold().toFloat()|formatNumber(0)})|raw }}
    {% elseif milestoneCategory == categoryEnum.ACTIVITY_DISTANCE %}
        {{ "Longest distance"|trans }}: {{ context.getValue()|renderMeasurement(1)|raw }}
    {% elseif milestoneCategory == categoryEnum.ACTIVITY_ELEVATION %}
        {{ "Most elevation"|trans }}: {{ context.getValue()|renderMeasurement(0)|raw }}
    {% elseif milestoneCategory == categoryEnum.ACTIVITY_MOVING_TIME %}
        {{ "Longest activity"|trans }}: {{ context.getValue()|formatSeconds }}
    {% elseif milestoneCategory == categoryEnum.PERSONAL_BEST %}
        {% set distance = context.getDistance() %}
        {{ "New personal best for"|trans }} {{ distance.isLowerThanOne() ? distance.toFloat()|round(1) : distance.toInt() }}<span class="text-xxs ml-px">{{ distance.getSymbol() }}</span>: {{ context.getTime()|formatSecondsAsPaddedClock }}
    {% elseif milestoneCategory == categoryEnum.EDDINGTON %}
        {{ context.getLabel() }}: {{ "reached Eddington number {number}"|trans({'{number}': context.getNumber()}) }}
    {% elseif milestoneCategory == categoryEnum.STREAK %}
        {{ "{days} consecutive days of activity"|trans({'{days}': context.getDays()}) }}
    {% elseif milestoneCategory == categoryEnum.GEAR_DISTANCE %}
        {{ "{threshold} total distance using {gearName}"|trans({
            '{threshold}': context.getThreshold()|renderMeasurement(0),
            '{gearName}': context.getGearName()
        })|raw }}
    {% elseif milestoneCategory == categoryEnum.GEAR_ELEVATION %}
        {{ "{threshold} total elevation using {gearName}"|trans({
            '{threshold}': context.getThreshold()|renderMeasurement(0),
            '{gearName}': context.getGearName()
        })|raw }}
    {% elseif milestoneCategory == categoryEnum.GEAR_MOVING_TIME %}
        {{ "{threshold} hours using {gearName}"|trans({
            '{threshold}': context.getThreshold().toFloat()|formatNumber(0),
            '{gearName}': context.getGearName()
        })|raw }}
    {% endif %}
{% endmacro %}

{% macro previousMilestoneThreshold(milestoneCategory, previousMilestone) %}
    {% set categoryEnum = enum('App\\Domain\\Milestone\\MilestoneCategory') %}
    {% if milestoneCategory == categoryEnum.PERSONAL_BEST %}
        <span class="underline">{{ previousMilestone.getThreshold()|formatSecondsAsPaddedClock }}</span>
    {% elseif milestoneCategory == categoryEnum.ACTIVITY_MOVING_TIME %}
        <span class="underline">{{ previousMilestone.getThreshold()|formatSeconds }}</span>
    {% else %}
        <span class="underline">{{ previousMilestone.getThreshold()|renderMeasurement(0)|raw }}</span>
    {% endif %}
{% endmacro %}