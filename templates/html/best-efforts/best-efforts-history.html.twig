{% set distanceLabel = (distance.isLowerThanOne() ? distance.toFloat()|round(1) : distance.toInt()) ~ ' ' ~ distance.getSymbol() %}
{% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [
    {
        'url': 'best-efforts',
        'label': 'Best efforts'|trans
    },
    {
        'url': 'best-efforts/' ~ activityType.value ~ '/' ~ distance.toMeter().toInt(),
        'label': (activityType|trans) ~ ' - ' ~ distanceLabel
    }]} %}
{% autoescape false %}
    {% set sportTypes = bestEfforts.getSportTypesFor(period, activityType) %}
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-4">
        <div class="mb-4 flex items-center justify-between">
            <h1 class="flex items-center text-lg font-semibold text-gray-900">
                <span>{{ "Best efforts"|trans }} - {{ activityType|trans }} - {{ distanceLabel }}</span>
            </h1>
        </div>
        <div class="grid grid-cols-1 gap-4">
            <div class="relative overflow-x-auto">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th scope="col" class="sticky left-0 bg-gray-50">
                            <div class="flex items-center justify-center" title="{{ "Ranking"|trans }}">
                               {{ "Rank"|trans }}
                            </div>
                        </th>
                        {% for sportType in sportTypes %}
                            <th scope="col">
                                {{ sportType|trans }}
                            </th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for i in 0..9 %}
                        <tr class="group/row">
                            <th scope="row"
                                class="sticky left-0 bg-white font-medium text-gray-900 whitespace-nowrap">
                                {{ loop.index }}
                            </th>
                            {% for sportType in sportTypes %}
                                {% set bestEffort = bestEfforts.historyFor(sportType, distance, i) %}
                                {% if bestEffort %}
                                    {% set activity = activitiesPerActivityId[bestEffort.getActivityId()] %}
                                    <td class="truncate">
                                        <div class="font-semibold text-gray-700">{{ bestEffort.getFormattedTime() }}</div>
                                        <div class="text-xs">{{ activity.getStartDate()|formatDate() }}</div>
                                        <div class="text-xs inline-flex">{{ activity|activityLink(ellipses: 50) }}</div>
                                    </td>
                                {% else %}
                                    <td class="truncate"> - </td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endautoescape %}